[["s_med1", "Ich bin Arzt.", "ихь бин арцт", "Я врач.", 1, "Ich bin Arzt."], ["s_med2", "Sind Sie Patient?", "зинт зи пациэнт", "Вы пациент?", 1, "Sind Sie Patient?"], ["s_med3", "Er ist krank.", "эа ист кранк", "Он болен.", 1, "Er ist krank."], ["h_med1", "Ich habe Schmerzen.", "ихь хабэ шмэрцэн", "У меня боли.", 1, "Ich habe Schmerzen."], ["h_med2", "Haben Sie Fieber?", "хабэн зи фибэа", "У Вас температура?", 1, "Haben Sie Fieber?"], ["h_med3", "Sie hat Husten.", "зи хат хустэн", "У неё кашель.", 1, "Sie hat Husten."], ["vh1", "Er nimmt keine Tabletten.", "эа нимт кайнэ таблэттэн", "Он не принимает таблетки.", 1, "Er nimmt keine Tabletten."], ["vh2", "Sie schläft schlecht.", "зи шлэфт шлехьт", "Она плохо спит.", 1, "Sie schläft schlecht."], ["vh3", "Isst du genug?", "ист ду гэнук", "Ты достаточно ешь?", 1, "Isst du genug?"], ["vh4", "Der Patient spricht kein Deutsch.", "дэа пациэнт шприхьт кайн дойч", "Пациент не говорит по-немецки.", 1, "Der Patient spricht kein Deutsch."], ["vh5", "Er läuft schlecht.", "эа лойфт шлехьт", "Он плохо ходит.", 1, "Er läuft schlecht."], ["vh6", "Sie vergisst oft ihre Tabletten.", "зи фэргист офт ирэ таблэттэн", "Она часто забывает свои таблетки.", 1, "Sie vergisst oft ihre Tabletten."], ["w_wer", "wer", "вэа", "кто", 0, "wer"], ["w_was", "was", "вас", "что", 0, "was"], ["w_wo", "wo", "во", "где", 0, "wo"], ["w_woher", "woher", "вохэа", "откуда", 0, "woher"], ["w_wohin", "wohin", "вохин", "куда", 0, "wohin"], ["w_wie", "wie", "ви", "как", 0, "wie"], ["w_wann", "wann", "ван", "когда", 0, "wann"], ["w_warum", "warum", "варум", "почему", 0, "warum"], ["w_wielange", "wie lange", "ви лангэ", "как долго", 0, "wie lange"], ["w_wieviel", "wie viel", "ви филь", "сколько", 0, "wie viel"], ["w_welcher", "welcher/welche/welches", "вэльхэа, вэльхе, вэльхес", "какой/какая/какое", 0, "welcher/welche/welches"], ["wv1", "Wie viel Wasser trinken Sie?", "ви филь вассэа тринкэн зи", "Сколько воды Вы пьёте?", 1, "Wie viel Wasser trinken Sie?"], ["wv2", "Wie viele Tabletten nehmen Sie?", "ви филе таблэттэн нээмэн зи", "Сколько таблеток Вы принимаете?", 1, "Wie viele Tabletten nehmen Sie?"], ["wl1", "Welcher Arzt?", "вэльхэа арцт", "Какой врач? (der)", 1, "Welcher Arzt?"], ["wl2", "Welche Tablette?", "вэльхе таблэттэ", "Какая таблетка? (die)", 1, "Welche Tablette?"], ["wl3", "Welches Bein?", "вэльхес байн", "Какая нога? (das Bein)", 1, "Welches Bein?"], ["q1", "Wie heißen Sie?", "ви хайсэн зи", "Как Вас зовут?", 1, "Wie heißen Sie?"], ["q2", "Wie alt sind Sie?", "ви альт зинт зи", "Сколько Вам лет?", 1, "Wie alt sind Sie?"], ["q3", "Wo haben Sie Schmerzen?", "во хабэн зи шмэрцэн", "Где у Вас болит?", 1, "Wo haben Sie Schmerzen?"], ["q4", "Was tut weh?", "вас тут вэ", "Что болит?", 1, "Was tut weh?"], ["q5", "Wie lange haben Sie die Schmerzen?", "ви лангэ хабэн зи ди шмэрцэн", "Как давно у Вас эти боли?", 1, "Wie lange haben Sie die Schmerzen?"], ["q6", "Wann kommen Sie wieder?", "ван коммэн зи видэа", "Когда Вы придёте снова?", 1, "Wann kommen Sie wieder?"], ["q7", "Welche Tabletten nehmen Sie?", "вэльхе таблэттэн нээмэн зи", "Какие таблетки Вы принимаете?", 1, "Welche Tabletten nehmen Sie?"], ["q8", "Warum sind Sie heute hier?", "варум зинт зи хойтэ хиа", "Почему Вы сегодня здесь?", 1, "Warum sind Sie heute hier?"], ["aq1", "Seit wann haben Sie die Beschwerden?", "зайт ван хабэн зи ди бэшвэрдэн", "С какого времени у Вас эти жалобы?", 1, "Seit wann haben Sie die Beschwerden?"], ["aq2", "Wie oft haben Sie Kopfschmerzen?", "ви офт хабэн зи копфшмэрцэн", "Как часто у Вас болит голова?", 1, "Wie oft haben Sie Kopfschmerzen?"], ["aq3", "Wie stark sind die Schmerzen?", "ви штарк зинт ди шмэрцэн", "Насколько сильная боль?", 1, "Wie stark sind die Schmerzen?"], ["aq4", "Wann sind die Schmerzen am schlimmsten?", "ван зинт ди шмэрцэн ам шлимстэн", "Когда боль сильнее всего?", 1, "Wann sind die Schmerzen am schlimmsten?"], ["aq5", "Welche Krankheiten haben Sie?", "вэльхе кранкхайтэн хабэн зи", "Какие у Вас заболевания?", 1, "Welche Krankheiten haben Sie?"], ["aq6", "Wer ist Ihr Hausarzt?", "вэа ист иа хаусарцт", "Кто Ваш семейный врач?", 1, "Wer ist Ihr Hausarzt?"], ["d1", "Guten Tag! Wie heißen Sie?", "гутэн так! ви хайсэн зи", "Здравствуйте! Как Вас зовут?", 1, "Guten Tag! Wie heißen Sie?"], ["d2", "Ich heiße Peter Klein.", "ихь хайсэ пэтэа кляйн", "Меня зовут Петер Кляйн.", 1, "Ich heiße Peter Klein."], ["d3", "Wie alt sind Sie, Herr Klein?", "ви альт зинт зи, хэа кляйн", "Сколько Вам лет, господин Кляйн?", 1, "Wie alt sind Sie, Herr Klein?"], ["d4", "Ich bin vierzig Jahre alt.", "ихь бин фирцихь ярэ альт", "Мне сорок лет.", 1, "Ich bin vierzig Jahre alt."], ["d5", "Wo haben Sie Schmerzen?", "во хабэн зи шмэрцэн", "Где у Вас болит?", 1, "Wo haben Sie Schmerzen?"], ["d6", "Ich habe Schmerzen im Bein. Ich schlafe schlecht.", "ихь хабэ шмэрцэн им байн. ихь шлафэ шлехьт", "У меня болит нога. Я плохо сплю.", 1, "Ich habe Schmerzen im Bein. Ich schlafe schlecht."], ["d7", "Wie lange schon? Und welche Tabletten nehmen Sie?", "ви лангэ шон? унт вэльхе таблэттэн нээмэн зи", "Как давно? И какие таблетки Вы принимаете?", 1, "Wie lange schon? Und welche Tabletten nehmen Sie?"], ["d8", "Zwei Wochen. Ich nehme nichts.", "цвай вохэн. ихь нээмэ нихьтс", "Две недели. Я ничего не принимаю.", 1, "Zwei Wochen. Ich nehme nichts."], ["fa1", "Guten Tag, Frau Berger! Was führt Sie zu mir?", "гутэн так, фрау бэргэа! вас фюрт зи цу миа", "Здравствуйте, фрау Бергер! Что Вас привело ко мне?", 1, "Guten Tag, Frau Berger! Was führt Sie zu mir?"], ["fa2", "Ich habe Schmerzen in den Beinen.", "ихь хабэ шмэрцэн ин дэн байнэн", "У меня болят ноги.", 1, "Ich habe Schmerzen in den Beinen."], ["fa3", "Seit wann haben Sie die Beschwerden?", "зайт ван хабэн зи ди бэшвэрдэн", "С какого времени эти жалобы?", 1, "Seit wann haben Sie die Beschwerden?"], ["fa4", "Seit drei Monaten.", "зайт драй монатэн", "Уже три месяца.", 1, "Seit drei Monaten."], ["fa5", "Wann sind die Schmerzen am schlimmsten?", "ван зинт ди шмэрцэн ам шлимстэн", "Когда боль сильнее всего?", 1, "Wann sind die Schmerzen am schlimmsten?"], ["fa6", "Am Abend. Die Beine sind dann schwer.", "ам абэнт. ди байнэ зинт дан швэа", "Вечером. Ноги тогда тяжёлые.", 1, "Am Abend. Die Beine sind dann schwer."], ["fa7", "Welche Medikamente nehmen Sie?", "вэльхе мэдикамэнтэ нээмэн зи", "Какие лекарства Вы принимаете?", 1, "Welche Medikamente nehmen Sie?"], ["fa8", "Ich nehme nur Aspirin.", "ихь нээмэ нуа аспирин", "Только аспирин.", 1, "Ich nehme nur Aspirin."], ["fa9", "Wie viele Tabletten am Tag?", "ви филе таблэттэн ам так", "Сколько таблеток в день?", 1, "Wie viele Tabletten am Tag?"], ["fa10", "Eine am Morgen.", "айнэ ам морген", "Одну утром.", 1, "Eine am Morgen."], ["kw1", "Du siehst müde aus, Grigori.", "ду зист мюдэ аус, григори", "Ты выглядишь усталым, Григорий.", 1, "Du siehst müde aus, Grigori."], ["kw2", "Ja, ich schlafe schlecht.", "я, ихь шлафэ шлехьт", "Да, я плохо сплю.", 1, "Ja, ich schlafe schlecht."], ["kw3", "Und isst du genug?", "унт ист ду гэнук", "А ешь ты достаточно?", 1, "Und isst du genug?"], ["kw4", "Nein, ich esse wenig. Ich arbeite zu viel.", "найн, ихь эссэ вэних. ихь арбайтэ цу филь", "Нет, мало ем. Слишком много работаю.", 1, "Nein, ich esse wenig. Ich arbeite zu viel."], ["kw5", "Fährst du am Wochenende weg?", "фэрст ду ам вохэнэндэ вэк", "Ты уезжаешь на выходные?", 1, "Fährst du am Wochenende weg?"], ["kw6", "Ja, ich fahre ans Meer. Dort schlafe ich gut.", "я, ихь фарэ анс мэа. дорт шлафэ ихь гут", "Да, еду на море. Там я хорошо сплю.", 1, "Ja, ich fahre ans Meer. Dort schlafe ich gut."]]