[["hb1", "Ich habe Zeit.", "ихь хабэ цайт", "У меня есть время.", 1, "Ich habe Zeit."], ["hb5", "Haben Sie Kinder?", "хабэн зи киндэа", "У Вас есть дети?", 1, "Haben Sie Kinder?"], ["hb2", "Hast du Hunger?", "хаст ду хунгэа", "Ты голоден? — дословно «имеешь голод»", 1, "Hast du Hunger?"], ["hb3", "Ich habe Durst.", "ихь хабэ дурст", "Я хочу пить.", 1, "Ich habe Durst."], ["hb4", "Er hat Angst.", "эа хат ангст", "Он боится.", 1, "Er hat Angst."], ["akk1", "Ich habe einen Termin.", "ихь хабэ айнэн тэрмин", "У меня запись на приём. (der Termin → einen)", 1, "Ich habe <b>einen</b> Termin."], ["akk2", "Ich habe eine Frage.", "ихь хабэ айнэ фрагэ", "У меня вопрос. (die Frage — не меняется)", 1, "Ich habe <b>eine</b> Frage."], ["akk3", "Ich habe ein Rezept.", "ихь хабэ айн рэцэпт", "У меня рецепт. (das Rezept — не меняется)", 1, "Ich habe <b>ein</b> Rezept."], ["ak4", "Ich brauche einen Termin.", "ихь браухэ айнэн тэрмин", "Мне нужна запись на приём.", 1, "Ich brauche <b>einen</b> Termin."], ["ak5", "Ich suche den Arzt.", "ихь зухэ дэн арцт", "Я ищу врача. (der → den)", 1, "Ich suche <b>den</b> Arzt."], ["ak6", "Ich nehme die Tablette.", "ихь нээмэ ди таблэттэ", "Я принимаю таблетку. (die — без изменений)", 1, "Ich nehme <b>die</b> Tablette."], ["ak7", "Ich sehe das Problem.", "ихь зээ дас проблем", "Я вижу проблему. (das — без изменений)", 1, "Ich sehe <b>das</b> Problem."], ["m1", "Ich habe Schmerzen.", "ихь хабэ шмэрцэн", "У меня боли.", 1, "Ich habe Schmerzen."], ["m2", "Ich habe Fieber.", "ихь хабэ фибэа", "У меня температура.", 1, "Ich habe Fieber."], ["m3", "Ich habe Husten.", "ихь хабэ хустэн", "У меня кашель.", 1, "Ich habe Husten."], ["mx6", "Ich habe Schnupfen.", "ихь хабэ шнупфэн", "У меня насморк.", 1, "Ich habe Schnupfen."], ["m4", "Ich habe Kopfschmerzen.", "ихь хабэ копфшмэрцэн", "У меня болит голова.", 1, "Ich habe Kopfschmerzen."], ["mx1", "Ich habe Bauchschmerzen.", "ихь хабэ баухшмэрцэн", "У меня болит живот.", 1, "Ich habe Bauchschmerzen."], ["mx2", "Ich habe Rückenschmerzen.", "ихь хабэ рюкэншмэрцэн", "У меня болит спина.", 1, "Ich habe Rückenschmerzen."], ["m5", "Haben Sie Schmerzen?", "хабэн зи шмэрцэн", "У Вас болит?", 1, "Haben Sie Schmerzen?"], ["m6", "Wo haben Sie Schmerzen?", "во хабэн зи шмэрцэн", "Где у Вас болит?", 1, "Wo haben Sie Schmerzen?"], ["mx3", "Haben Sie Allergien?", "хабэн зи аллергиэн", "У Вас есть аллергия?", 1, "Haben Sie Allergien?"], ["mx4", "Seit wann haben Sie Schmerzen?", "зайт ван хабэн зи шмэрцэн", "С какого времени болит?", 1, "Seit wann haben Sie Schmerzen?"], ["mx5", "Seit drei Tagen.", "зайт драй тагэн", "Уже три дня.", 1, "Seit drei Tagen."], ["sm1", "Kopfschmerzen", "копфшмэрцэн", "головная боль — der Kopf, голова", 1, "Kopfschmerzen"], ["sm2", "Halsschmerzen", "хальсшмэрцэн", "боль в горле — der Hals, горло", 1, "Halsschmerzen"], ["sm3", "Bauchschmerzen", "баухшмэрцэн", "боль в животе — der Bauch, живот", 1, "Bauchschmerzen"], ["sm4", "Rückenschmerzen", "рюкэншмэрцэн", "боль в спине — der Rücken, спина", 1, "Rückenschmerzen"], ["sm5", "Zahnschmerzen", "цаншмэрцэн", "зубная боль — der Zahn, зуб", 1, "Zahnschmerzen"], ["sm6", "Ohrenschmerzen", "орэншмэрцэн", "боль в ушах — das Ohr, ухо", 1, "Ohrenschmerzen"], ["n1", "Ich habe keinen Termin.", "ихь хабэ кайнэн тэрмин", "У меня нет записи. (der → keinen)", 1, "Ich habe <b>keinen</b> Termin."], ["n2", "Ich habe keine Schmerzen.", "ихь хабэ кайнэ шмэрцэн", "У меня нет болей.", 1, "Ich habe <b>keine</b> Schmerzen."], ["n3", "Ich habe kein Fieber.", "ихь хабэ кайн фибэа", "У меня нет температуры.", 1, "Ich habe <b>kein</b> Fieber."], ["kn1", "Ich habe keine Allergien.", "ихь хабэ кайнэ аллергиэн", "У меня нет аллергии.", 1, "Ich habe <b>keine</b> Allergien."], ["kn2", "Ich habe keinen Hunger.", "ихь хабэ кайнэн хунгэа", "Я не голоден.", 1, "Ich habe <b>keinen</b> Hunger."], ["kn3", "Das ist kein Problem.", "дас ист кайн проблем", "Это не проблема.", 1, "Das ist <b>kein</b> Problem."], ["kn4", "Ich habe keine Kinder.", "ихь хабэ кайнэ киндэа", "У меня нет детей.", 1, "Ich habe <b>keine</b> Kinder."], ["n4", "Das ist nicht gut.", "дас ист нихьт гут", "Это нехорошо.", 1, "Das ist <b>nicht</b> gut."], ["n5", "Ich verstehe nicht.", "ихь фэрштээ нихьт", "Я не понимаю.", 1, "Ich verstehe <b>nicht</b>."], ["nn1", "Ich rauche nicht.", "ихь раухэ нихьт", "Я не курю.", 1, "Ich rauche <b>nicht</b>."], ["nn2", "Das tut nicht weh.", "дас тут нихьт вэ", "Это не больно.", 1, "Das tut <b>nicht</b> weh."], ["nn3", "Ich bin nicht krank.", "ихь бин нихьт кранк", "Я не болен.", 1, "Ich bin <b>nicht</b> krank."], ["nn4", "Der Arzt ist heute nicht da.", "дэа арцт ист хойтэ нихьт да", "Врача сегодня нет.", 1, "Der Arzt ist heute <b>nicht</b> da."], ["kx1", "Ich habe kein Auto.", "ихь хабэ кайн ауто", "У меня нет машины. — «ein Auto» → kein", 1, "Ich habe <b>kein</b> Auto."], ["kx2", "Das ist nicht mein Auto.", "дас ист нихьт майн ауто", "Это не моя машина. — с mein → nicht", 1, "Das ist <b>nicht</b> mein Auto."], ["d1", "Guten Tag! Was haben Sie?", "гутэн так! вас хабэн зи", "Здравствуйте! На что жалуетесь?", 1, "Guten Tag! Was haben Sie?"], ["dm2", "Ich habe Schmerzen und Fieber.", "ихь хабэ шмэрцэн унт фибэа", "У меня боли и температура.", 1, "Ich habe Schmerzen und Fieber."], ["d3", "Wo haben Sie Schmerzen?", "во хабэн зи шмэрцэн", "Где болит?", 1, "Wo haben Sie Schmerzen?"], ["dm4", "Ich habe Kopfschmerzen und Halsschmerzen.", "ихь хабэ копфшмэрцэн унт хальсшмэрцэн", "Голова и горло.", 1, "Ich habe Kopfschmerzen und Halsschmerzen."], ["d5", "Haben Sie Husten?", "хабэн зи хустэн", "Кашель есть?", 1, "Haben Sie Husten?"], ["dm6", "Ja, aber ich habe keine Atemnot.", "я, абэа ихь хабэ кайнэ атэмнот", "Да, но одышки нет.", 1, "Ja, aber ich habe keine Atemnot."], ["d7", "Sie haben eine Erkältung. Hier ist ein Rezept.", "зи хабэн айнэ эркэльтунг. хиа ист айн рэцэпт", "У Вас простуда. Вот рецепт.", 1, "Sie haben eine Erkältung. Hier ist ein Rezept."], ["dm8", "Vielen Dank, Frau Doktor!", "филен данк, фрау доктор", "Спасибо, доктор!", 1, "Vielen Dank, Frau Doktor!"], ["ap1", "Guten Tag! Was brauchen Sie?", "гутэн так! вас браухэн зи", "Здравствуйте! Что Вам нужно?", 1, "Guten Tag! Was brauchen Sie?"], ["ap2", "Ich habe ein Rezept.", "ихь хабэ айн рэцэпт", "У меня рецепт.", 1, "Ich habe ein Rezept."], ["ap3", "Danke. Haben Sie noch eine Frage?", "данкэ. хабэн зи нох айнэ фрагэ", "Спасибо. Есть ещё вопрос?", 1, "Danke. Haben Sie noch eine Frage?"], ["ap4", "Ja. Haben Sie auch Tabletten gegen Husten?", "я. хабэн зи аух таблэттэн гэгэн хустэн", "Да. У Вас есть таблетки от кашля?", 1, "Ja. Haben Sie auch Tabletten gegen Husten?"], ["ap5", "Ja, natürlich. Haben Sie Fieber?", "я, натюрлихь. хабэн зи фибэа", "Да, конечно. У Вас температура?", 1, "Ja, natürlich. Haben Sie Fieber?"], ["ap6", "Nein, ich habe kein Fieber.", "найн, ихь хабэ кайн фибэа", "Нет, температуры нет.", 1, "Nein, ich habe kein Fieber."], ["ap7", "Gut. Dann nehmen Sie diese Tabletten.", "гут. дан нээмэн зи дизэ таблэттэн", "Хорошо. Тогда принимайте эти таблетки.", 1, "Gut. Dann nehmen Sie diese Tabletten."], ["ap8", "Vielen Dank! Auf Wiedersehen!", "филен данк! ауф видэрзээн", "Большое спасибо! До свидания!", 1, "Vielen Dank! Auf Wiedersehen!"], ["rk1", "Guten Tag, Frau Klein! Was haben Sie?", "гутэн так, фрау кляйн! вас хабэн зи", "Здравствуйте, фрау Кляйн! На что жалуетесь?", 1, "Guten Tag, Frau Klein! Was haben Sie?"], ["rk2", "Ich habe Rückenschmerzen.", "ихь хабэ рюкэншмэрцэн", "У меня болит спина.", 1, "Ich habe Rückenschmerzen."], ["rk3", "Seit wann haben Sie Schmerzen?", "зайт ван хабэн зи шмэрцэн", "С какого времени болит?", 1, "Seit wann haben Sie Schmerzen?"], ["rk4", "Seit drei Tagen.", "зайт драй тагэн", "Уже три дня.", 1, "Seit drei Tagen."], ["rk5", "Haben Sie Allergien?", "хабэн зи аллергиэн", "У Вас есть аллергия?", 1, "Haben Sie Allergien?"], ["rk6", "Nein, ich habe keine Allergien.", "найн, ихь хабэ кайнэ аллергиэн", "Нет, аллергии нет.", 1, "Nein, ich habe keine Allergien."], ["rk7", "Gut. Ich untersuche Sie jetzt. Das tut nicht weh.", "гут. ихь унтэрзухэ зи етцт. дас тут нихьт вэ", "Хорошо. Сейчас я Вас осмотрю. Это не больно.", 1, "Gut. Ich untersuche Sie jetzt. Das tut nicht weh."], ["rk8", "Danke, Herr Doktor.", "данкэ, хэа доктор", "Спасибо, доктор.", 1, "Danke, Herr Doktor."]]