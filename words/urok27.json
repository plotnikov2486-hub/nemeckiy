[["c1", "Der Arzt untersucht den Patienten.", "дэа арцт унтазухт дэн пациентэн", "Aktiv: врач осматривает пациента", 1, "<b>Der Arzt untersucht</b> den Patienten."], ["c2", "Der Patient wird untersucht.", "дэа пациент вирт унтазухт", "Passiv: пациента осматривают", 1, "<b>Der Patient wird untersucht.</b>"], ["c3", "Die Schwester misst den Blutdruck.", "ди швэста мист дэн блутдрук", "Aktiv: медсестра меряет давление", 1, "<b>Die Schwester misst</b> den Blutdruck."], ["c4", "Der Blutdruck wird gemessen.", "дэа блутдрук вирт гэмэсэн", "Passiv: давление меряют", 1, "<b>Der Blutdruck wird gemessen.</b>"], ["c5", "Der Chirurg operiert den Patienten heute.", "дэа хирург опэрирт дэн пациентэн хойтэ", "Aktiv: хирург оперирует пациента сегодня", 1, "<b>Der Chirurg operiert</b> den Patienten heute."], ["c6", "Der Patient wird heute operiert.", "дэа пациент вирт хойтэ опэрирт", "Passiv: пациента оперируют сегодня", 1, "<b>Der Patient wird heute operiert.</b>"], ["f1", "Der Patient wird operiert.", "дэа пациент вирт опэрирт", "Пациента оперируют.", 1, "Der Patient <b>wird</b> operiert."], ["f2", "Die Patientin wird operiert.", "ди пациентин вирт опэрирт", "Пациентку оперируют.", 1, "Die Patientin <b>wird</b> operiert."], ["f3", "Die Kinder werden geimpft.", "ди киндэа вэрдэн гэимпфт", "Детей прививают.", 1, "Die Kinder <b>werden</b> geimpft."], ["f4", "Ich werde geröntgt.", "ихь вэрдэ гэрёнтгт", "Мне делают рентген.", 1, "Ich <b>werde</b> geröntgt."], ["p1", "messen → gemessen", "мэсэн → гэмэсэн", "измерять → измерено (сильный: ge-...-en)", 0, "messen → gemessen"], ["p2", "wechseln → gewechselt", "вэксэльн → гэвэксэльт", "менять (повязку) → заменено (обычный: ge-...-t)", 0, "wechseln → gewechselt"], ["p3", "impfen → geimpft", "импфэн → гэимпфт", "прививать → привито (обычный)", 0, "impfen → geimpft"], ["p4", "operieren → operiert", "опэрирэн → опэрирт", "оперировать → прооперировано (-ieren — без ge-)", 0, "operieren → operiert"], ["p5", "desinfizieren → desinfiziert", "дэзинфицирэн → дэзинфицирт", "дезинфицировать → продезинфицировано (-ieren)", 0, "desinfizieren → desinfiziert"], ["p6", "untersuchen → untersucht", "унтазухэн → унтазухт", "осматривать → осмотрено (unter- — без ge-)", 0, "untersuchen → untersucht"], ["p7", "verschreiben → verschrieben", "фэршрайбэн → фэршрибэн", "выписывать (рецепт) → выписано (ver- — без ge-)", 0, "verschreiben → verschrieben"], ["p8", "behandeln → behandelt", "бэхандэльн → бэхандэльт", "лечить → пролечено (be- — без ge-)", 0, "behandeln → behandelt"], ["p9", "abnehmen → abgenommen", "апнэмэн → апгэномэн", "брать (кровь) → взято (ab- отделяемая: ge- внутрь)", 0, "abnehmen → abgenommen"], ["sp1", "ich werde untersucht", "ихь вэрдэ унтазухт", "меня осматривают", 1, "<b>ich werde</b> untersucht"], ["sp2", "du wirst untersucht", "ду вирст унтазухт", "тебя осматривают", 1, "<b>du wirst</b> untersucht"], ["sp3", "er wird untersucht", "эа вирт унтазухт", "его осматривают", 1, "<b>er wird</b> untersucht"], ["sp4", "wir werden untersucht", "виа вэрдэн унтазухт", "нас осматривают", 1, "<b>wir werden</b> untersucht"], ["sp5", "ihr werdet untersucht", "иа вэрдэт унтазухт", "вас осматривают (свои)", 1, "<b>ihr werdet</b> untersucht"], ["sp6", "sie werden untersucht", "зи вэрдэн унтазухт", "их осматривают / Вас осматривают (вежл.)", 1, "<b>sie werden</b> untersucht"], ["v1", "Der Patient wird von der Ärztin untersucht.", "дэа пациент вирт фон дэа эрцтин унтазухт", "Пациента осматривает врач (женщина).", 1, "Der Patient wird <b>von der</b> Ärztin untersucht."], ["v2", "Die Wunde wird vom Chirurgen genäht.", "ди вундэ вирт фом ширургэн гэнэт", "Рану зашивает хирург.", 1, "Die Wunde wird <b>vom</b> Chirurgen genäht."], ["v3", "Der Verband wird von der Krankenschwester gewechselt.", "дэа фэрбант вирт фон дэа кранкэншвэста гэвэксэльт", "Повязку меняет медсестра.", 1, "Der Verband wird <b>von der</b> Krankenschwester gewechselt."], ["v4", "Das Rezept wird vom Arzt unterschrieben.", "дас рэцэпт вирт фом арцт унташрибэн", "Рецепт подписывает врач.", 1, "Das Rezept wird <b>vom</b> Arzt unterschrieben."], ["m1", "Man misst den Blutdruck.", "ман мист дэн блутдрук", "Давление меряют. (= Der Blutdruck wird gemessen.)", 1, "<b>Man misst</b> den Blutdruck."], ["m2", "Hier raucht man nicht.", "хиа раухт ман нихьт", "Здесь не курят. (= Hier wird nicht geraucht.)", 1, "Hier <b>raucht man</b> nicht."], ["m3", "Man schließt die Fenster abends.", "ман шлист ди фэнста абэнтс", "Окна закрывают вечером.", 1, "<b>Man schließt</b> die Fenster abends."], ["w1", "Der Blutdruck wird gemessen.", "дэа блутдрук вирт гэмэсэн", "Измеряют давление.", 1, "Der Blutdruck wird gemessen."], ["w2", "Die Wunde wird desinfiziert.", "ди вундэ вирт дэзинфицирт", "Рану дезинфицируют.", 1, "Die Wunde wird desinfiziert."], ["w3", "Der Verband wird gewechselt.", "дэа фэрбант вирт гэвэксэльт", "Повязку меняют.", 1, "Der Verband wird gewechselt."], ["w4", "Das Blut wird abgenommen.", "дас блут вирт апгэномэн", "Берут кровь.", 1, "Das Blut wird abgenommen."], ["w5", "Der Patient wird geröntgt.", "дэа пациент вирт гэрёнтгт", "Пациенту делают рентген.", 1, "Der Patient wird geröntgt."], ["w6", "Die Tabletten werden verschrieben.", "ди таблэтэн вэрдэн фэршрибэн", "Таблетки выписывают.", 1, "Die Tabletten werden verschrieben."], ["w7", "Es wird empfohlen, viel zu trinken.", "эс вирт эмпфолэн, филь цу тринкэн", "Рекомендуется много пить.", 1, "<b>Es wird empfohlen, viel zu trinken.</b>"], ["w8", "Der Patient wird morgen operiert.", "дэа пациент вирт моргэн опэрирт", "Пациента оперируют завтра.", 1, "Der Patient wird morgen operiert."], ["w9", "Die Ergebnisse werden heute besprochen.", "ди эргэбнисэ вэрдэн хойтэ бэшпрохэн", "Результаты обсуждают сегодня.", 1, "Die Ergebnisse werden heute besprochen."], ["wo1", "der Verband", "дэа фэрбант", "повязка", 0, "der Verband"], ["wo2", "die Wunde", "ди вундэ", "рана", 0, "die Wunde"], ["wo3", "der Blutdruck", "дэа блутдрук", "давление (крови)", 0, "der Blutdruck"], ["wo4", "abnehmen", "апнэмэн", "брать (кровь), снимать (мерки)", 0, "abnehmen"], ["wo5", "röntgen", "рёнтгэн", "делать рентген", 0, "röntgen"], ["wo6", "verschreiben", "фэршрайбэн", "выписывать (рецепт)", 0, "verschreiben"], ["wo7", "empfehlen", "эмпфелэн", "рекомендовать", 0, "empfehlen"], ["wo8", "besprechen", "бэшпрэхэн", "обсуждать", 0, "besprechen"], ["wo9", "wehtun", "вэтун", "причинять боль, болеть", 0, "wehtun"], ["wo10", "sich Sorgen machen", "зихь зоргэн махэн", "волноваться, беспокоиться", 0, "sich Sorgen machen"], ["e1", "Der Patient wird untersuchen.", "дэа пациент вирт унтазухэн", "❌ инфинитив вместо Partizip II", 1, "Der Patient wird <b>untersuchen</b>."], ["e2", "Der Patient wird untersucht.", "дэа пациент вирт унтазухт", "✅ Partizip II в конце", 1, "Der Patient wird <b>untersucht</b>."], ["e3", "Der Arzt wird den Patienten untersucht.", "дэа арцт вирт дэн пациентэн унтазухт", "❌ дополнение осталось на месте подлежащего", 1, "Der Arzt wird <b>den Patienten</b> untersucht."], ["e4", "Der Patient wird von dem Arzt untersucht.", "дэа пациент вирт фон дэм арцт унтазухт", "✅ пациент — подлежащее", 1, "<b>Der Patient</b> wird von dem Arzt untersucht."], ["e5", "Die Wunde wird von der Arzt verbunden.", "ди вундэ вирт фон дэа арцт фэрбундэн", "❌ der Arzt мужского рода, Dativ — dem", 1, "Die Wunde wird von <b>der</b> Arzt verbunden."], ["e6", "Die Wunde wird von dem Arzt verbunden.", "ди вундэ вирт фон дэм арцт фэрбундэн", "✅ von dem = vom", 1, "Die Wunde wird von <b>dem</b> Arzt verbunden."], ["x1", "Der Blutdruck wird gemessen.", "дэа блутдрук вирт гэмэсэн", "Давление измеряют.", 1, "Der Blutdruck wird gemessen."], ["x2", "Die Wunde wird genäht.", "ди вундэ вирт гэнэт", "Рану зашивают.", 1, "Die Wunde wird genäht."], ["x3", "Wird der Patient heute operiert?", "вирт дэа пациент хойтэ опэрирт", "Пациента сегодня оперируют?", 1, "Wird der Patient heute operiert?"], ["x4", "Nein, er wird erst morgen operiert.", "найн, эа вирт эрст моргэн опэрирт", "Нет, его оперируют только завтра.", 1, "Nein, er wird erst morgen operiert."], ["x5", "Das Rezept wird vom Arzt unterschrieben.", "дас рэцэпт вирт фом арцт унташрибэн", "Рецепт подписывает врач.", 1, "Das Rezept wird vom Arzt unterschrieben."], ["x6", "Es wird empfohlen, viel Wasser zu trinken.", "эс вирт эмпфолэн, филь васа цу тринкэн", "Рекомендуется пить много воды.", 1, "Es wird empfohlen, viel Wasser zu trinken."], ["x7", "Die Tabletten werden nach dem Essen genommen.", "ди таблэтэн вэрдэн нах дэм эсэн гэномэн", "Таблетки принимают после еды.", 1, "Die Tabletten werden nach dem Essen genommen."], ["x8", "Der Verband wird jeden Tag gewechselt.", "дэа фэрбант вирт едэн так гэвэксэльт", "Повязку меняют каждый день.", 1, "Der Verband wird jeden Tag gewechselt."], ["d1", "Was wird heute mit Herrn Krause gemacht?", "вас вирт хойтэ мит хэрн краузэ гэмахт", "Что сегодня делают с господином Краузе?", 1, "Was wird heute mit Herrn Krause gemacht?"], ["d2", "Der Verband wird gewechselt, und der Blutdruck wird gemessen.", "дэа фэрбант вирт гэвэксэльт, унт дэа блутдрук вирт гэмэсэн", "Меняют повязку и измеряют давление.", 1, "Der Verband wird gewechselt, und der Blutdruck wird gemessen."], ["d3", "Wird er heute schon operiert?", "вирт эа хойтэ шон опэрирт", "Его уже сегодня оперируют?", 1, "Wird er heute schon operiert?"], ["d4", "Nein, er wird erst morgen operiert.", "найн, эа вирт эрст моргэн опэрирт", "Нет, его оперируют только завтра.", 1, "Nein, er wird erst morgen operiert."], ["d5", "Und die Tabletten, werden die schon verschrieben?", "унт ди таблэтэн, вэрдэн ди шон фэршрибэн", "А таблетки, их уже выписывают?", 1, "Und die Tabletten, werden die schon verschrieben?"], ["d6", "Ja, es wird empfohlen, sie nach dem Essen zu nehmen.", "я, эс вирт эмпфолэн, зи нах дэм эсэн цу нэмэн", "Да, рекомендуется принимать их после еды.", 1, "Ja, es wird empfohlen, sie nach dem Essen zu nehmen."], ["g1", "Heute wird bei Ihnen eine Untersuchung gemacht.", "хойтэ вирт бай инэн айнэ унтазухунг гэмахт", "Сегодня вам проведут обследование.", 1, "Heute wird bei Ihnen eine Untersuchung gemacht."], ["g2", "Was wird genau gemacht?", "вас вирт гэнау гэмахт", "Что именно будут делать?", 1, "Was wird genau gemacht?"], ["g3", "Zuerst wird der Blutdruck gemessen, dann wird Blut abgenommen.", "цуэрст вирт дэа блутдрук гэмэсэн, дан вирт блут апгэномэн", "Сначала измерят давление, потом возьмут кровь.", 1, "Zuerst wird der Blutdruck gemessen, dann wird Blut abgenommen."], ["g4", "Tut das weh?", "тут дас вэ", "Это больно?", 1, "Tut das weh?"], ["g5", "Nein, keine Sorge. Es wird alles genau erklärt.", "найн, кайнэ зоргэ. эс вирт алэс гэнау эрклэрт", "Нет, не волнуйтесь. Всё подробно объяснят.", 1, "Nein, keine Sorge. Es wird alles genau erklärt."], ["g6", "Gut, dann bin ich bereit.", "гут, дан бин ихь бэрайт", "Хорошо, тогда я готов.", 1, "Gut, dann bin ich bereit."]]