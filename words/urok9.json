[["pl1","der Arm → die Arme","","рука → руки (-e)",1],["pl2","das Bein → die Beine","","нога → ноги (-e)",1],["pl3","die Hand → die Hände","","кисть → кисти (-e + умляут)",1],["pl4","der Fuß → die Füße","","стопа → стопы (-e + умляут)",1],["pl5","das Auge → die Augen","","глаз → глаза (-en)",1],["w1","Wo tut es weh?","","Где болит?",1],["w2","Der Kopf tut weh.","","Голова болит.",1],["w3","Der Rücken tut weh.","","Спина болит.",1],["w6","Hier tut es weh.","","Вот здесь болит.",1],["s1","Ich habe Kopfschmerzen.","","У меня головная боль.",0],["s2","Ich habe Bauchschmerzen.","","У меня болит живот.",0],["s3","Ich habe Rückenschmerzen.","","У меня боль в спине.",0],["s5","Ich habe Zahnschmerzen.","","У меня болит зуб.",0],["s6","Ich habe Schmerzen im Bein.","","У меня боль в ноге.",1],["f1","Meine Beine sind schwer.","","Мои ноги тяжёлые.",1],["f2","Die Venen tun weh.","","Вены болят.",1],["f3","Das Bein ist geschwollen.","","Нога отёкшая.",1],["d1","Guten Tag! Was fehlt Ihnen?","","Здравствуйте! Что Вас беспокоит?",1],["d2","Mein Rücken tut weh. Ich habe starke Rückenschmerzen.","","Спина болит. У меня сильная боль в спине.",1],["d3","Wo genau tut es weh? Hier?","","Где именно болит? Здесь?",1],["d4","Ja, hier unten. Und das linke Bein tut auch weh.","","Да, вот здесь внизу. И левая нога тоже болит.",1],["d5","Seit wann haben Sie die Schmerzen?","","С каких пор у Вас эти боли?",1],["d6","Seit drei Tagen. Die Beine sind auch schwer.","","Три дня. Ноги ещё и тяжёлые.",1],["d7","Gut. Ich untersuche jetzt Ihr Bein und Ihre Venen.","","Хорошо. Сейчас осмотрю Вашу ногу и вены.",1]]