[["s_fru", "der Frühling", "дэа фрюлинг", "весна", 0, "der Frühling"], ["s_som", "der Sommer", "дэа зоммэа", "лето", 0, "der Sommer"], ["s_her", "der Herbst", "дэа хэрпст", "осень", 0, "der Herbst"], ["s_win", "der Winter", "дэа винтэа", "зима", 0, "der Winter"], ["mo1", "der Januar", "януар", "январь", 0, "der Januar"], ["mo2", "der Februar", "фэбруар", "февраль", 0, "der Februar"], ["mo3", "der März", "мэрц", "март", 0, "der März"], ["mo4", "der April", "априль", "апрель", 0, "der April"], ["mo5", "der Mai", "май", "май", 0, "der Mai"], ["mo6", "der Juni", "юни", "июнь", 0, "der Juni"], ["mo7", "der Juli", "юли", "июль", 0, "der Juli"], ["mo8", "der August", "аугуст", "август", 0, "der August"], ["mo9", "der September", "зэптэмбэа", "сентябрь", 0, "der September"], ["mo10", "der Oktober", "октобэа", "октябрь", 0, "der Oktober"], ["mo11", "der November", "новэмбэа", "ноябрь", 0, "der November"], ["mo12", "der Dezember", "дэцэмбэа", "декабрь", 0, "der Dezember"], ["im1", "Im Sommer ist es warm.", "им зоммэа ист эс варм", "Летом тепло.", 1, "Im Sommer ist es warm."], ["im2", "Im Winter ist es kalt.", "им винтэа ист эс кальт", "Зимой холодно.", 1, "Im Winter ist es kalt."], ["im7", "Im Herbst regnet es oft.", "им хэрпст рэгнэт эс офт", "Осенью часто идёт дождь.", 1, "Im Herbst regnet es oft."], ["im5", "Der Termin ist im März.", "дэа тэрмин ист им мэрц", "Приём в марте.", 1, "Der Termin ist im März."], ["im6", "Im Juli habe ich Urlaub.", "им юли хабэ ихь урлауп", "В июле у меня отпуск.", 1, "Im Juli habe ich Urlaub."], ["date_q", "Welches Datum ist heute?", "вэльхес датум ист хойтэ", "Какое сегодня число?", 1, "Welches Datum ist heute?"], ["date_today", "Heute ist der sechste August.", "хойтэ ист дэа зэкстэ аугуст", "Сегодня 6 августа.", 1, "Heute ist der sechste August."], ["dt1", "Heute ist der erste März.", "хойтэ ист дэа эрстэ мэрц", "Сегодня первое марта.", 1, "Heute ist der erste März."], ["ord", "der erste, der zweite, der dritte, der vierte, der fünfte", "дэа 