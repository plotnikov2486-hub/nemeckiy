[["wg1", "Wie geht es Ihnen?", "ви гэт эс инэн", "Как у Вас дела? — вежливо", 1, "Wie geht es Ihnen?"], ["wg2", "Wie geht's?", "ви гэтс", "Как дела? — по-свойски", 1, "Wie geht's?"], ["wx5", "Na, wie geht's?", "на, ви гэтс", "Ну, как дела? — по-дружески", 1, "Na, wie geht's?"], ["wx4", "Alles gut?", "аллес гут", "Всё хорошо?", 1, "Alles gut?"], ["wg6", "Sehr gut, danke!", "зэр гут, данкэ", "Очень хорошо, спасибо!", 1, "Sehr gut, danke!"], ["wg3", "Danke, gut. Und Ihnen?", "данкэ, гут. унт инэн", "Спасибо, хорошо. А у Вас?", 1, "Danke, gut. Und Ihnen?"], ["wx1", "Mir geht es gut.", "миа гэт эс гут", "У меня всё хорошо.", 1, "Mir geht es gut."], ["wg4", "Danke, es geht.", "данкэ, эс гэт", "Спасибо, так себе.", 1, "Danke, es geht."], ["wg5", "Nicht so gut.", "нихьт зо гут", "Не очень.", 1, "Nicht so gut."], ["wx3", "Mir geht es nicht gut.", "миа гэт эс нихьт гут", "Мне нехорошо.", 1, "Mir geht es nicht gut."], ["wx2", "Es geht mir schon besser.", "эс гэт миа шон бэсэа", "Мне уже лучше.", 1, "Es geht mir schon besser."], ["wx6", "Geht es Ihnen heute besser?", "гэт эс инэн хойтэ бэсэа", "Вам сегодня лучше?", 1, "Geht es Ihnen heute besser?"], ["wx7", "Was fehlt Ihnen?", "вас фэльт инэн", "Что Вас беспокоит?", 1, "Was fehlt Ihnen?"], ["nt1", "sechs, sechzehn", "зэкс, зэхьцэн", "6, 16 — в sechzehn пропадает s", 1, "sechs, sechzehn"], ["nt2", "sieben, siebzehn", "зибэн, зипцэн", "7, 17 — в siebzehn пропадает -en", 1, "sieben, siebzehn"], ["nt3", "zwei, zwölf, zwanzig", "цвай, цвёльф, цванцихь", "2, 12, 20 — три разных слова", 1, "zwei, zwölf, zwanzig"], ["nt4", "Ich habe ein Kind.", "ихь хабэ айн кинт", "У меня один ребёнок. — перед словом ein", 1, "Ich habe ein Kind."], ["nt5", "Zimmer eins", "циммэа айнс", "кабинет номер один — без слова после: eins", 1, "Zimmer eins"], ["nt6", "zwo", "цво", "«два» по телефону — чтобы не спутать с drei", 1, "zwo"], ["age1", "Wie alt sind Sie?", "ви альт зинт зи", "Сколько Вам лет?", 1, "Wie alt sind Sie?"], ["al1", "Wie alt bist du?", "ви