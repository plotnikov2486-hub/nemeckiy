[["c_rot", "rot", "рот", "красный", 0, "rot"], ["c_blau", "blau", "блау", "синий, голубой", 0, "blau"], ["c_gruen", "grün", "грюн", "зелёный", 0, "grün"], ["c_gelb", "gelb", "гельп", "жёлтый", 0, "gelb"], ["c_orange", "orange", "оронжэ", "оранжевый", 0, "orange"], ["c_lila", "lila", "лила", "фиолетовый", 0, "lila"], ["c_rosa", "rosa", "роза", "розовый", 0, "rosa"], ["c_braun", "braun", "браун", "коричневый", 0, "braun"], ["c_schwarz", "schwarz", "шварц", "чёрный", 0, "schwarz"], ["c_weiss", "weiß", "вайс", "белый", 0, "weiß"], ["c_grau", "grau", "грау", "серый", 0, "grau"], ["hellblau", "hellblau", "хэльблау", "светло-синий", 0, "hellblau"], ["dunkelgruen", "dunkelgrün", "дункэльгрюн", "тёмно-зелёный", 0, "dunkelgrün"], ["sh1", "dunkelblau", "дункэльблау", "тёмно-синий", 0, "dunkelblau"], ["sh2", "hellgrün", "хэльгрюн", "светло-зелёный", 0, "hellgrün"], ["sh3", "dunkelrot", "дункэльрот", "тёмно-красный", 0, "dunkelrot"], ["q1", "Welche Farbe ist das?", "вэльхе фарбэ ист дас", "Какого это цвета?", 1, "Welche Farbe ist das?"], ["q2", "Das ist rot.", "дас ист рот", "Это красное.", 1, "Das ist rot."], ["q3", "Der Apfel ist grün.", "дэа апфэль ист грюн", "Яблоко зелёное.", 1, "Der Apfel ist grün."], ["q4", "Welche Farbe hat Ihr Auto?", "вэльхе фарбэ хат иа ауто", "Какого цвета Ваша машина?", 1, "Welche Farbe hat Ihr Auto?"], ["q5", "Mein Auto ist schwarz.", "майн ауто ист шварц", "Моя машина чёрная.", 1, "Mein Auto ist schwarz."], ["q6", "Meine Lieblingsfarbe ist Blau.", "майнэ либлингсфарбэ ист блау", "Мой любимый цвет — синий.", 1, "Meine Lieblingsfarbe ist Blau."], ["ad1", "die weiße Tablette", "ди вайсэ таблэттэ", "белая таблетка", 1, "die weiße Tablette"], ["ad2", "ein rotes Auto", "айн ротэс ауто", "красная машина", 1, "ein rotes Auto"], ["ad3", "eine gelbe Tablette", "айнэ гельбэ таблэттэ", "жёлтая таблетка", 1, "eine gelbe Tablette"], ["m1", "Die Haut ist blass.", "ди хаут ист блас", "Кожа бледная.", 1, "Die Haut ist blass."], ["mx1", "Die Haut ist gelb.", "ди хаут ист гельп", "Кожа жёлтая (желтуха).", 1, "Die Haut ist gelb."], ["m2", "Die Lippen sind blau.", "ди липпэн зинт блау", "Губы синие (цианоз).", 1, "Die Lippen sind blau."], ["mx2", "Das Bein ist rot und warm.", "дас байн ист рот унт варм", "Нога красная и горячая.", 1, "Das Bein ist rot und warm."], ["mx3", "Die Vene ist blau.", "ди вэнэ ист блау", "Вена синяя.", 1, "Die Vene ist blau."], ["m3", "ein blauer Fleck", "айн блауэр флек", "синяк", 1, "ein blauer Fleck"], ["mx4", "Der Fuß ist blass und kalt.", "дэа фус ист блас унт кальт", "Стопа бледная и холодная.", 1, "Der Fuß ist blass und kalt."], ["mx5", "Die Zunge ist weiß.", "ди цунгэ ист вайс", "Язык обложен (белый).", 1, "Die Zunge ist weiß."], ["m4", "Der Urin ist gelb.", "дэа урин ист гельп", "Моча жёлтая.", 1, "Der Urin ist gelb."], ["fm1", "Die Tablette ist rund und weiß.", "ди таблэттэ ист рунт унт вайс", "Таблетка круглая и белая.", 1, "Die Tablette ist rund und weiß."], ["fm2", "Die Kapsel ist rot.", "ди капсэль ист рот", "Капсула красная.", 1, "Die Kapsel ist rot."], ["fm3", "Nehmen Sie die blaue Tablette am Morgen.", "нээмэн зи ди блауэ таблэттэ ам морген", "Синюю таблетку принимайте утром.", 1, "Nehmen Sie die blaue Tablette am Morgen."], ["id1", "Ich sehe schwarz.", "ихь зээ шварц", "Я настроен пессимистично. — «вижу чёрное»", 1, "Ich sehe schwarz."], ["id2", "Er ist blau.", "эа ист блау", "Он пьян! — не «ему грустно»", 1, "Er ist blau."], ["id3", "Er ist noch grün hinter den Ohren.", "эа ист нох грюн хинтэа дэн орэн", "Он ещё молокосос. — «зелёный за ушами»", 1, "Er ist noch grün hinter den Ohren."], ["id4", "Er fährt schwarz.", "эа фэрт шварц", "Он едет зайцем.", 1, "Er fährt schwarz."], ["d1", "Welche Farbe haben die Tabletten?", "вэльхе фарбэ хабэн ди таблэттэн", "Какого цвета таблетки?", 1, "Welche Farbe haben die Tabletten?"], ["dm2", "Sie sind weiß und rund.", "зи зинт вайс унт рунт", "Они белые и круглые.", 1, "Sie sind weiß und rund."], ["d3", "Und der Ausschlag? Welche Farbe hat er?", "унт