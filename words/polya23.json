[["gv1", "einschlafen", "айншлафэн", "засыпать — отделяемая", 0, "einschlafen"], ["gv2", "verstehen", "фэрштээн", "понимать — неотделяемая", 0, "verstehen"], ["gv3", "vorlesen", "фоалээзэн", "читать вслух — отделяемая", 0, "vorlesen"], ["gv4", "erklären", "эрклээрэн", "объяснять — неотделяемая", 0, "erklären"], ["gv5", "mitmachen", "митмахэн", "участвовать, делать вместе — отделяемая", 0, "mitmachen"], ["gv6", "erzählen → nacherzählen", "эрцээлэн → нахэрцээлэн", "рассказывать → пересказывать (nach- отделяется, er- остаётся)", 0, "erzählen → nacherzählen"], ["gv7", "zuhören", "цухёрэн", "слушать (внимательно) — отделяемая", 0, "zuhören"], ["gv8", "einladen", "айнлаадэн", "приглашать — отделяемая", 0, "einladen"], ["gv9", "mitnehmen", "митнээмэн", "брать с собой — отделяемая", 0, "mitnehmen"], ["gv10", "besuchen", "бэзухэн", "навещать, посещать — неотделяемая", 0, "besuchen"], ["gv11", "vorbereiten / sich vorbereiten", "фоабэрайтэн / зихь фоабэрайтэн", "приготавливать / готовиться — отделяемая", 0, "vorbereiten / sich vorbereiten"], ["gv12", "aufstehen", "ауфштээн", "вставать — отделяемая", 0, "aufstehen"], ["gv13", "bemalen", "бэмаалэн", "раскрашивать, разрисовывать — неотделяемая", 0, "bemalen"], ["gv14", "vergessen", "фэргэсэн", "забывать — неотделяемая", 0, "vergessen"], ["gv15", "anziehen", "анцииэн", "надевать — отделяемая", 0, "anziehen"], ["gv16", "bekommen", "бэкомэн", "получать — неотделяемая", 0, "bekommen"], ["gp1", "Ich erkläre dir die Aufgabe.", "их эрклээрэ дир ди ауфгаабэ", "Я объясняю тебе задание.", 1, "Ich <b>erkläre</b> dir die Aufgabe."], ["gp2", "Ich lade dich zur Party ein.", "их лаадэ дихь цур парти айн", "Я приглашаю тебя на вечеринку.", 1, "Ich <b>lade</b> dich zur Party <b>ein</b>."], ["gp3", "Er nimmt den Kaffee mit.", "эа нимт дэн кафэ мит", "Он берёт кофе с собой.", 1, "Er <b>nimmt</b> den Kaffee <b>mit</b>."], ["gp4", "Einen Kaffee zum Mitnehmen, bitte!", "айнэн кафэ цум митнээмэн, битэ", "Кофе с собой, пожалуйста! (так говорят в кафе)", 1, "Einen Kaffee zum Mitnehmen, bitte!"], ["gp5", "Ich bereite heute das Essen vor.", "их бэрайтэ хойтэ дас эсэн фоа", "Сегодня я готовлю еду.", 1, "Ich <b>bereite</b> heute das Essen <b>vor</b>."], ["gp6", "Ich stehe jeden Morgen um sechs Uhr auf.", "их штээ йэдэн моргэн ум зэкс уа ауф", "Я встаю каждое утро в шесть часов.", 1, "Ich <b>stehe</b> jeden Morgen um sechs Uhr <b>auf</b>."], ["gp7", "Ich bemale die Wände.", "их бэмаалэ ди вэндэ", "Я раскрашиваю стены.", 1, "Ich <b>bemale</b> die Wände."], ["gp8", "Du ziehst die Schuhe an.", "ду цииист ди шуэ ан", "Ты надеваешь ботинки.", 1, "Du <b>ziehst</b> die Schuhe <b>an</b>."], ["km1", "Morgen fahren wir nach Köln. Kommst du auch mit?", "моргэн фаарэн вир нах кёльн. комст ду аух мит", "Завтра мы едем в Кёльн. Ты поедешь с нами?", 1, "Morgen fahren wir nach Köln. Kommst du auch <b>mit</b>?"], ["km2", "Jens ist seit Tagen im Haus und kommt einfach nicht heraus.", "йэнс ист зайт таагэн им хаус унт комт айнфах нихьт хэраус", "Йенс уже несколько дней дома и просто не выходит наружу.", 1, "Jens ist seit Tagen im Haus und kommt einfach nicht <b>heraus</b>."], ["km3", "Kommen Sie bitte her! Ich brauche Ihre Hilfe.", "комэн зи битэ хээа! их браухэ ирэ хильфэ", "Подойдите, пожалуйста, сюда! Мне нужна ваша помощь.", 1, "Kommen Sie bitte <b>her</b>! Ich brauche Ihre Hilfe."], ["km4", "Besuchst du mich? Am Samstag komme ich vorbei.", "бэзухст ду михь? ам замстаак комэ их форбай", "Навестишь меня? В субботу я к тебе загляну.", 1, "Besuchst du mich? Am Samstag komme ich <b>vorbei</b>."], ["km5", "Um wie viel Uhr kommt der Zug am Bahnhof an?", "ум ви филь уа комт дэа цук ам баанхоф ан", "Во сколько поезд прибывает на вокзал?", 1, "Um wie viel Uhr kommt der Zug am Bahnhof <b>an</b>?"], ["km6", "Unsere Oma besucht uns. Ich hole sie vom Bahnhof ab.", "унзэрэ оома бэзухт унс. их хоолэ зи фом баанхоф ап", "Наша бабушка нас навещает. Я заберу её с вокзала.", 1, "Unsere Oma besucht uns. Ich hole sie vom Bahnhof <b>ab</b>."], ["ge1", "🇦🇹 heimgehen — Warum geht ihr jetzt schon heim?", "хаймгээн — варум гээт ир йэцт шоон хайм", "идти домой (очень австрийское) — Почему вы уже идёте домой?", 1, "🇦🇹 heimgehen — Warum geht ihr jetzt schon heim?"], ["ge2", "Wir sind sehr müde.", "вир зинт зээа мюдэ", "Мы очень устали.", 1, "Wir sind sehr müde."], ["ge3", "losgehen — Ich warte schon seit Stunden. Wann gehen wir endlich los?", "лоосгээн — их вартэ шоон зайт штундэн. ван гээн вир эндлихь лоос", "трогаться, начинать идти — Я жду уже несколько часов. Когда мы уже пойдём?", 1, "losgehen — Ich warte schon seit Stunden. Wann gehen wir endlich los?"], ["ge4", "weggehen — Gehen Sie weg! Lassen Sie mich in Ruhe!", "вэкгээн — гээн зи вэк! ласэн зи михь ин руэ", "уходить — Уйдите! Оставьте меня в покое! (грубо!)", 1, "weggehen — Gehen Sie weg! Lassen Sie mich in Ruhe!"], ["ge5", "ausgehen — Heute Abend gehe ich mit meinem Freund aus.", "аусгээн — хойтэ аабэнт гээ их мит майнэм фройнт аус", "выходить «в свет», гулять, развлекаться — Сегодня вечером я иду гулять с другом.", 1, "ausgehen — Heute Abend gehe ich mit meinem Freund aus."], ["ge6", "angehen — Auf der Bühne geht das Licht an.", "ангээн — ауф дэа бюнэ гээт дас лихьт ан", "включаться, загораться — На сцене загорается свет.", 1, "angehen — Auf der Bühne geht das Licht an."], ["zi1", "anziehen · ausziehen · sich umziehen", "анцииэн · аусцииэн · зихь умцииэн", "надевать · снимать · переодеваться (одежда)", 1, "anziehen · ausziehen · sich umziehen"], ["zi2", "Der Junge zieht die Hose an. Das Mädchen zieht die Jacke aus.", "дэа юнгэ циит ди хоозэ ан. дас мээдхьэн циит ди якэ аус", "Мальчик надевает брюки. Девочка снимает куртку.", 1, "Der Junge zieht die Hose an. Das Mädchen zieht die Jacke aus."], ["zi3", "Der Sportler wechselt seine Sportkleidung. Er zieht sich um.", "дэа шпортла вэксэльт зайнэ шпорт-клайдунг. эа циит зихь ум", "Спортсмен меняет спортивную одежду. Он переодевается.", 1, "Der Sportler wechselt seine Sportkleidung. Er zieht sich um."], ["zi4", "einziehen · ausziehen · umziehen — der Umzug", "айнцииэн · аусцииэн · умцииэн — дэа умцуук", "въезжать · выезжать · переезжать (жильё) — переезд", 1, "einziehen · ausziehen · umziehen — der Umzug"], ["zi5", "Endlich ist unser Haus fertig. Am Wochenende ziehen wir ein.", "эндлихь ист унза хаус фэртихь. ам вохэнэндэ цииэн вир айн", "Наконец-то наш дом готов. В выходные мы въезжаем.", 1, "Endlich ist unser Haus fertig. Am Wochenende ziehen wir ein."], ["zi6", "einsteigen · aussteigen · umsteigen", "айнштайгэн · аусштайгэн · умштайгэн", "садиться · выходить · пересаживаться (транспорт) — та же логика ein / aus / um", 1, "einsteigen · aussteigen · umsteigen"], ["mh1", "Herr Jakobi macht das Fenster auf. Seine Frau macht es wieder zu.", "хэр якоби махт дас фэнста ауф. зайнэ фрау махт эс видэа цу", "Господин Якоби открывает окно. Его жена снова его закрывает.", 1, "Herr Jakobi macht das Fenster auf. Seine Frau macht es wieder zu."], ["mh2", "Wir sind sehr müde. Wir machen die Augen zu und schlafen ein.", "вир зинт зээа мюдэ. вир махэн ди аугэн цу унт шлаафэн айн", "Мы очень устали. Мы закрываем глаза и засыпаем.", 1, "Wir sind sehr müde. Wir machen die Augen zu und schlafen ein."], ["mh3", "Das Kind träumt schlecht. Es wacht auf und weint.", "дас кинт тройгмт шлэхт. эс вахт ауф унт вайнт", "Ребёнку снится плохой сон. Он просыпается и плачет.", 1, "Das Kind träumt schlecht. Es wacht auf und weint."], ["mh4", "aufwachen ≠ aufstehen", "ауфвахэн ≠ ауфштээн", "проснуться ≠ встать (с кровати)", 1, "aufwachen ≠ aufstehen"], ["nh1", "Ich fahre nach Köln / nach Budapest.", "их фаарэ нах кёльн / нах будапэшт", "Я еду в Кёльн / в Будапешт. (город → nach)", 1, "Ich fahre <b>nach</b> Köln / <b>nach</b> Budapest."], ["nh2", "Ich fahre nach Deutschland / nach Russland.", "их фаарэ нах дойчлант / нах руслант", "Я еду в Германию / в Россию. (страна без артикля → nach)", 1, "Ich fahre <b>nach</b> Deutschland / <b>nach</b> Russland."], ["nh3", "Ich fahre in die Stadt.", "их фаарэ ин ди штат", "Я еду в город (в центр). — не nach!", 1, "Ich fahre <b>in die</b> Stadt."], ["rp1", "Hanna Bogner ist 28 Jahre alt und arbeitet als Redakteurin.", "ханна богна ист ахт-унт-цванцихь яарэ альт унт арбайтэт альс рэдактёрин", "Ханне Богнер 28 лет, она работает редактором.", 1, "Hanna Bogner ist 28 Jahre alt und arbeitet als Redakteurin."], ["rp2", "Warum nimmt sie nicht das Auto? Hat sie kein Auto? — Doch, aber ich fahre nicht so oft Auto.", "варум нимт зи нихьт дас ауто? хат зи кайн ауто? — дохь, аба их фаарэ нихьт зо офт ауто", "Почему она не берёт машину? У неё нет машины? — Есть, но я нечасто езжу на машине.", 1, "Warum nimmt sie nicht das Auto? Hat sie kein Auto? — Doch, aber ich fahre nicht so oft Auto."], ["rp3", "Ich mag die öffentlichen Verkehrsmittel.", "их маак ди эфэнтлихьэн фэркээрсмитэль", "Я люблю общественный транспорт.", 1, "Ich mag die öffentlichen Verkehrsmittel."], ["rp4", "So kann sie am Morgen noch gemütlich Zeitung lesen.", "зо кан зи ам моргэн нохь гэмютлихь цайтунг лээзэн", "Так утром она может ещё спокойно почитать газету.", 1, "So kann sie am Morgen noch gemütlich Zeitung lesen."], ["rp5", "Um 8.45 Uhr kommt sie im Büro an — ganz entspannt und ohne Stress.", "ум фиртэль фоа нойн комт зи им бюро ан — ганц энтшпант унт оонэ штрэс", "В 8:45 она приезжает в офис — совсем расслабленная и без стресса.", 1, "Um 8.45 Uhr kommt sie im Büro an — ganz entspannt und ohne Stress."], ["wo1", "die Bühne", "ди бюнэ", "сцена", 0, "die Bühne"], ["wo2", "die Zuschauer", "ди цушауа", "зрители", 0, "die Zuschauer"], ["wo3", "quatschen", "квачэн", "болтать", 0, "quatschen"], ["wo4", "die Ruhe · ruhig", "ди руэ · руихь", "спокойствие · тихий, спокойный", 0, "die Ruhe · ruhig"], ["wo5", "lassen", "ласэн", "оставлять", 0, "lassen"], ["wo6", "träumen", "тройгмэн", "видеть сны; мечтать", 0, "träumen"], ["wo7", "endlich", "эндлихь", "наконец-то", 0, "endlich"], ["wo8", "doch", "дохь", "да (нет), всё-таки — возражение на вопрос с отрицанием", 0, "doch"], ["wo9", "die öffentl