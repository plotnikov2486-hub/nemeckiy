[["c1", "Ich habe das Bein untersucht.", "ихь хабэ дас байн унтазухт", "Perfekt — как скажешь в разговоре", 1, "<b>Ich habe</b> das Bein <b>untersucht</b>."], ["c2", "Ich untersuchte das Bein.", "ихь унтазухтэ дас байн", "Präteritum — как напишешь в выписке", 1, "<b>Ich untersuchte</b> das Bein."], ["c3", "Der Patient ist gekommen.", "дэа пациент ист гэкомэн", "Perfekt — разговор", 1, "Der Patient <b>ist gekommen</b>."], ["c4", "Der Patient kam.", "дэа пациент кам", "Präteritum — письмо", 1, "Der Patient <b>kam</b>."], ["sp1", "ich fragte", "ихь фрактэ", "я спросил", 0, "ich fragte"], ["sp2", "du fragtest", "ду фрактэст", "ты спросил", 0, "du fragtest"], ["sp3", "er fragte", "эа фрактэ", "он спросил", 0, "er fragte"], ["sp4", "wir fragten", "виа фрактэн", "мы спросили", 0, "wir fragten"], ["sp5", "ihr fragtet", "иа фрактэт", "вы спросили (свои)", 0, "ihr fragtet"], ["sp6", "sie fragten", "зи фрактэн", "они спросили", 0, "sie fragten"], ["f1", "Ich machte gestern eine Untersuchung.", "ихь махтэ гэстэрн айнэ унтазухунг", "Вчера я провёл обследование.", 1, "Ich <b>machte</b> gestern eine Untersuchung."], ["f2", "Er fragte nach den Symptomen.", "эа фрактэ нах дэн симптомэн", "Он спросил о симптомах.", 1, "Er <b>fragte</b> nach den Symptomen."], ["f3", "Wir untersuchten den Patienten.", "виа унтазухтэн дэн пациентэн", "Мы осмотрели пациента.", 1, "Wir <b>untersuchten</b> den Patienten."], ["f4", "Sie verordnete Tabletten.", "зи фэрорднэтэ таблэтэн", "Она назначила таблетки.", 1, "Sie <b>verordnete</b> Tabletten."], ["p1", "nehmen → nahm", "нэмэн → нам", "брать → взял", 0, "nehmen → nahm"], ["p2", "geben → gab", "гэбэн → гап", "давать → дал", 0, "geben → gab"], ["p3", "sehen → sah", "зэен → за", "видеть → увидел", 0, "sehen → sah"], ["p4", "kommen → kam", "комэн → кам", "приходить → пришёл", 0, "kommen → kam"], ["p5", "gehen → ging", "гэен → гинк", "идти → пошёл", 0, "gehen → ging"], ["p6", "sprechen → sprach", "шпрэхэн → шпрах", "говорить → сказал", 0, "sprechen → sprach"], ["p7", "schreiben → schrieb", "шрайбэн → шрип", "писать → написал", 0, "schreiben → schrieb"], ["p8", "finden → fand", "финдэн → фант", "находить → обнаружил", 0, "finden → fand"], ["p9", "beginnen → begann", "бэгинэн → бэган", "начинать → начал", 0, "beginnen → begann"], ["p10", "bekommen → bekam", "бэкомэн → бэкам", "получать → получил", 0, "bekommen → bekam"], ["m1", "bringen → brachte", "брингэн → брахтэ", "приносить → принёс", 0, "bringen → brachte"], ["m2", "denken → dachte", "дэнкэн → дахтэ", "думать → подумал", 0, "denken → dachte"], ["m3", "wissen → wusste", "висэн → вустэ", "знать → знал", 0, "wissen → wusste"], ["m4", "kennen → kannte", "кэнэн → кантэ", "быть знакомым → был знаком", 0, "kennen → kannte"], ["m5", "nennen → nannte", "нэнэн → нантэ", "называть → назвал", 0, "nennen → nannte"], ["w1", "Der Patient kam mit Schmerzen im Bein.", "дэа пациент кам мит шмэрцэн им байн", "Пациент обратился с болями в ноге.", 1, "Der Patient kam mit Schmerzen im Bein."], ["w2", "Er klagte über eine Schwellung.", "эа клактэ юба айнэ швэлунг", "Он жаловался на отёк.", 1, "Er klagte über eine Schwellung."], ["w3", "Die Untersuchung ergab eine Thrombose.", "ди унтазухунг эргап айнэ тромбозэ", "Обследование выявило тромбоз.", 1, "Die Untersuchung ergab eine Thrombose."], ["w4", "Wir verordneten eine Kompressionstherapie.", "виа фэрорднэтэн айнэ компрэсьонстэрапи", "Мы назначили компрессионную терапию.", 1, "Wir verordneten eine Kompressionstherapie."], ["w5", "Der Patient erhielt eine Antikoagulation.", "дэа пациент эрхильт айнэ антикоагуляцион", "Пациент получил антикоагулянтную терапию.", 1, "Der Patient erhielt eine Antikoagulation."], ["w6", "Der Zustand verbesserte sich deutlich.", "дэа цуштант фэрбэсэртэ зихь дойтлихь", "Состояние заметно улучшилось.", 1, "Der Zustand verbesserte sich deutlich."], ["w7", "Der Patient wurde am zwölften September aufgenommen.", "дэа пациент вурдэ ам цвёльфтэн зептэмба ауфгэномэн", "Пациент был госпитализирован 12 сентября.", 1, "Der Patient <b>wurde</b> am zwölften September <b>aufgenommen</b>."], ["w8", "Der Patient wurde am nächsten Tag entlassen.", "дэа пациент вурдэ ам нэхьстэн так энтласэн", "Пациент был выписан на следующий день.", 1, "Der Patient <b>wurde</b> am nächsten Tag <b>entlassen</b>."], ["e1", "Ich habte Schmerzen.", "ихь хабтэ шмэрцэн", "❌ такой формы не существует", 1, "Ich <b>habte</b> Schmerzen."], ["e2", "Ich hatte Schmerzen.", "ихь хатэ шмэрцэн", "✅ haben → hatte", 1, "Ich <b>hatte</b> Schmerzen."], ["e3", "Er kommte gestern.", "эа комтэ гэстэрн", "❌ у сильных глаголов нет -te", 1, "Er <b>kommte</b> gestern."], ["e4", "Er kam gestern.", "эа кам гэстэрн", "✅ kommen → kam", 1, "Er <b>kam</b> gestern."], ["e5", "Ich gehte nach Hause.", "ихь гэхтэ нах хаузэ", "❌ тоже сильный глагол", 1, "Ich <b>gehte</b> nach Hause."], ["e6", "Ich ging nach Hause.", "ихь гинк нах хаузэ", "✅ gehen → ging", 1, "Ich <b>ging</b> nach Hause."], ["t1", "Der Patient kam mit Schmerzen im linken Bein in die Praxis.", "дэа пациент кам мит шмэрцэн им линкэн байн ин ди праксис", "Пациент обратился в клинику с болями в левой ноге.", 1, "Der Patient kam mit Schmerzen im linken Bein in die Praxis."], ["t2", "Er klagte über eine Schwellung seit drei Tagen.", "эа клактэ юба айнэ швэлунг зайт драй тагэн", "Он жаловался на отёк в течение трёх дней.", 1, "Er klagte über eine Schwellung seit drei Tagen."], ["t3", "Die Untersuchung ergab eine Venenentzündung.", "ди унтазухунг эргап айнэ вэнэнэнцюндунг", "Обследование выявило воспаление вены.", 1, "Die Untersuchung ergab eine Venenentzündung."], ["t4", "Wir verordneten eine Kompressionstherapie und Bettruhe.", "виа фэрорднэтэн айнэ компрэсьонстэрапи унт бэтруэ", "Мы назначили компрессионную терапию и постельный режим.", 1, "Wir verordneten eine Kompressionstherapie und Bettruhe."], ["t5", "Der Zustand verbesserte sich innerhalb einer Woche deutlich.", "дэа цуштант фэрбэсэртэ зихь инахальп айна вохэ дойтлихь", "Состояние заметно улучшилось в течение недели.", 1, "Der Zustand verbesserte sich innerhalb einer Woche deutlich."], ["t6", "Der Patient wurde am Ende der Woche entlassen.", "дэа пациент вурдэ ам эндэ дэа вохэ энтласэн", "Пациент был выписан в конце недели.", 1, "Der Patient wurde am Ende der Woche entlassen."], ["x1", "Der Patient kam gestern in die Praxis.", "дэа пациент кам гэстэрн ин ди праксис", "Пациент обратился в клинику вчера.", 1, "Der Patient kam gestern in die Praxis."], ["x2", "Er klagte über Schmerzen im Bein.", "эа клактэ юба шмэрцэн им байн", "Он жаловался на боли в ноге.", 1, "Er klagte über Schmerzen im Bein."], ["x3", "Die Untersuchung ergab eine Venenentzündung.", "ди унтазухунг эргап айнэ вэнэнэнцюндунг", "Обследование выявило воспаление вены.", 1, "Die Untersuchung ergab eine Venenentzündung."], ["x4", "Wir verordneten Kompressionsstrümpfe.", "виа фэрорднэтэн компрэсьонсштрюмпфэ", "Мы назначили компрессионные чулки.", 1, "Wir verordneten Kompressionsstrümpfe."], ["x5", "Der Zustand verbesserte sich schnell.", "дэа цуштант фэрбэсэртэ зихь шнэль", "Состояние быстро улучшилось.", 1, "Der Zustand verbesserte sich schnell."], ["x6", "Ich untersuchte den Patienten um neun Uhr.", "ихь унтазухтэ дэн пациентэн ум нойн уа", "Я осмотрел пациента в девять часов.", 1, "Ich untersuchte den Patienten um neun Uhr."], ["x7", "Er wurde am Montag aufgenommen.", "эа вурдэ ам монтак ауфгэномэн", "Его госпитализировали в понедельник.", 1, "Er wurde am Montag aufgenommen."], ["x8", "Sie wurde am Freitag entlassen.", "зи вурдэ ам фрайтак энтласэн", "Её выписали в пятницу.", 1, "Sie wurde am Freitag entlassen."]]