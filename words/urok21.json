[["pr_ich", "ich — mich — mir", "ихь — михь — миа", "я — меня — мне", 0, "ich — <b>mich</b> — <b>mir</b>"], ["pr_du", "du — dich — dir", "ду — дихь — диа", "ты — тебя — тебе", 0, "du — <b>dich</b> — <b>dir</b>"], ["pr_er", "er — ihn — ihm", "эа — ин — им", "он — его — ему", 0, "er — <b>ihn</b> — <b>ihm</b>"], ["pr_sie", "sie — sie — ihr", "зи — зи — иа", "она — её — ей", 0, "sie — sie — <b>ihr</b>"], ["pr_es", "es — es — ihm", "эс — эс — им", "оно — его — ему", 0, "es — es — <b>ihm</b>"], ["pr_wir", "wir — uns — uns", "виа — унс — унс", "мы — нас — нам", 0, "wir — <b>uns</b> — <b>uns</b>"], ["pr_ihr", "ihr — euch — euch", "иа — ойхь — ойхь", "вы (свои) — вас — вам", 0, "ihr — <b>euch</b> — <b>euch</b>"], ["pr_siepl", "sie — sie — ihnen", "зи — зи — инэн", "они — их — им", 0, "sie — sie — <b>ihnen</b>"], ["pr_vy", "Sie — Sie — Ihnen", "зи — зи — инэн", "Вы — Вас — Вам", 0, "Sie — Sie — <b>Ihnen</b>"], ["a1", "Ich sehe dich morgen.", "ихь зээ дихь моргэн", "Увидимся завтра. (я вижу тебя)", 1, "Ich sehe <b>dich</b> morgen."], ["a2", "Kennst du ihn?", "кэнст ду ин", "Ты его знаешь?", 1, "Kennst du <b>ihn</b>?"], ["a3", "Der Arzt fragt mich.", "дэа арцт фрагт михь", "Врач спрашивает меня.", 1, "Der Arzt fragt <b>mich</b>."], ["a4", "Ich untersuche Sie jetzt.", "ихь унтэрзухэ зи йецт", "Сейчас я Вас осмотрю.", 1, "Ich untersuche <b>Sie</b> jetzt."], ["a5", "Ich rufe Sie morgen an.", "ихь руфэ зи моргэн ан", "Я позвоню Вам завтра. (anrufen — Akkusativ!)", 1, "Ich rufe <b>Sie</b> morgen an."], ["d1", "Kannst du mir helfen?", "канст ду миа хэльфэн", "Можешь мне помочь?", 1, "Kannst du <b>mir</b> helfen?"], ["d2", "Ich gebe Ihnen ein Rezept.", "ихь гэбэ инэн айн рэцэпт", "Я дам Вам рецепт.", 1, "Ich gebe <b>Ihnen</b> ein Rezept."], ["d3", "Ich zeige Ihnen den Weg.", "ихь цайгэ инэн дэн вэк", "Я покажу Вам дорогу.", 1, "Ich zeige <b>Ihnen</b> den Weg."], ["d4", "Das Buch gehört mir.", "дас бух гэхёрт миа", "Книга моя. (принадлежит мне)", 1, "Das Buch gehört <b>mir</b>."], ["d5", "Ich danke Ihnen.", "ихь данкэ инэн", "Благодарю Вас. (danken — Dativ!)", 1, "Ich danke <b>Ihnen</b>."], ["v_helfen", "helfen + D", "хэльфэн", "помогать кому", 0, "<b>helfen</b> + D"], ["v_danken", "danken + D", "данкэн", "благодарить кого (!)", 0, "<b>danken</b> + D"], ["v_gefallen", "gefallen + D", "гэфаллен", "нравиться кому", 0, "<b>gefallen</b> + D"], ["v_gehoeren", "gehören + D", "гэхёрэн", "принадлежать кому", 0, "<b>gehören</b> + D"], ["v_passen", "passen + D", "пассэн", "подходить кому (по размеру, по времени)", 0, "<b>passen</b> + D"], ["v_antworten", "antworten + D", "антвортэн", "отвечать кому", 0, "<b>antworten</b> + D"], ["v_glauben", "glauben + D", "глаубэн", "верить кому", 0, "<b>glauben</b> + D"], ["v_gratulieren", "gratulieren + D", "гратулирэн", "поздравлять кого (!)", 0, "<b>gratulieren</b> + D"], ["v_wehtun", "wehtun + D", "вээтун", "болеть — у кого: Mir tut … weh", 0, "<b>wehtun</b> + D"], ["ve1", "Die Wohnung gefällt mir.", "ди вонунг гэфэльт миа", "Мне нравится квартира.", 1, "Die Wohnung gefällt <b>mir</b>."], ["ve2", "Ich gratuliere dir zum Geburtstag!", "ихь гратулирэ диа цум гэбуртстак", "Поздравляю тебя с днём рождения!", 1, "Ich gratuliere <b>dir</b> zum Geburtstag!"], ["ve3", "Glauben Sie mir!", "глаубэн зи миа", "Поверьте мне!", 1, "Glauben Sie <b>mir</b>!"], ["ve4", "Er antwortet mir nicht.", "эа антвортэт миа нихьт", "Он мне не отвечает.", 1, "Er antwortet <b>mir</b> nicht."], ["ve5", "Passt Ihnen Montag um zehn?", "пасст инэн монтак ум цээн", "Вам подходит понедельник в десять?", 1, "Passt <b>Ihnen</b> Montag um zehn?"], ["mi1", "Mir ist schwindelig.", "миа ист швиндэлихь", "У меня кружится голова.", 1, "<b>Mir</b> ist schwindelig."], ["mi2", "Mir ist schlecht.", "миа ист шлехьт", "Мне плохо, меня тошнит.", 1, "<b>Mir</b> ist schlecht."], ["mi3", "Mir tut der Rücken weh.", "миа тут дэа рюкэн вээ", "У меня болит спина.", 1, "<b>Mir</b> tut der Rücken weh."], ["mi4", "Wie geht es Ihnen?", "ви гээт эс инэн", "Как Вы себя чувствуете?", 1, "Wie geht es <b>Ihnen</b>?"], ["mi5", "Es geht mir gut, danke.", "эс гээт миа гут, данкэ", "У меня всё хорошо, спасибо.", 1, "Es geht <b>mir</b> gut, danke."], ["zw1", "Ich gebe Ihnen das Rezept.", "ихь гэбэ инэн дас рэцэпт", "Я даю Вам рецепт. (сначала кому, потом что)", 1, "Ich gebe <b>Ihnen</b> das Rezept."], ["zw2", "Ich gebe es Ihnen.", "ихь гэбэ эс инэн", "Я даю его Вам. (оба местоимения — «что» первым)", 1, "Ich gebe <b>es Ihnen</b>."], ["m1", "Was fehlt Ihnen?", "вас фэльт инэн", "Что Вас беспокоит?", 1, "Was fehlt <b>Ihnen</b>?"], ["m2", "Wo tut es Ihnen weh?", "во тут эс инэн вээ", "Где у Вас болит?", 1, "Wo tut es <b>Ihnen</b> weh?"], ["m3", "Ich verschreibe Ihnen eine Salbe.", "ихь фэршрайбэ инэн айнэ зальбэ", "Я выпишу Вам мазь.", 1, "Ich verschreibe <b>Ihnen</b> eine Salbe."], ["m4", "Ich gebe Ihnen eine Spritze.", "ихь гэбэ инэн айнэ шприцэ", "Я сделаю Вам укол.", 1, "Ich gebe <b>Ihnen</b> eine Spritze."], ["m5", "Ich erkläre Ihnen die Operation.", "ихь эрклэрэ инэн ди опэрацьон", "Я объясню Вам, как пройдёт операция.", 1, "Ich erkläre <b>Ihnen</b> die Operation."], ["m6", "Hilft Ihnen die Salbe?", "хильфт инэн ди зальбэ", "Мазь Вам помогает?", 1, "Hilft <b>Ihnen</b> die Salbe?"], ["m7", "Passt Ihnen der Strumpf?", "пасст инэн дэа штрумпф", "Чулок Вам по размеру?", 1, "Passt <b>Ihnen</b> der Strumpf?"], ["m8", "Ist Ihnen schwindelig?", "ист инэн швиндэлихь", "У Вас кружится голова?", 1, "Ist <b>Ihnen</b> schwindelig?"], ["m9", "Ich überweise Sie zum Kardiologen.", "ихь юбэрвайзэ зи цум кардиолёгэн", "Я направлю Вас к кардиологу. (überweisen — Akkusativ)", 1, "Ich überweise <b>Sie</b> zum Kardiologen."], ["m10", "Rufen Sie mich an, wenn es schlimmer wird.", "руфэн зи михь ан, вэн эс шлиммэа вирт", "Позвоните мне, если станет хуже.", 1, "Rufen Sie <b>mich</b> an, wenn es schlimmer wird."], ["wf1", "Guten Tag! Was fehlt Ihnen?", "гутэн так! вас фэльт инэн", "Здравствуйте! Что Вас беспокоит?", 1, "Guten Tag! Was fehlt Ihnen?"], ["wf2", "Mir tut das linke Bein weh. Und abends ist mir oft schwindelig.", "миа тут дас линкэ байн вээ. унт абэндс ист миа офт швиндэлихь", "У меня болит левая нога. А вечером часто кружится голова.", 1, "Mir tut das linke Bein weh. Und abends ist mir oft schwindelig."], ["wf3", "Seit wann? Hilft Ihnen etwas?", "зайт ван? хильфт инэн этвас", "С каких пор? Вам что-нибудь помогает?", 1, "Seit wann? Hilft Ihnen etwas?"], ["wf4", "Seit zwei Wochen. Die Salbe hilft mir leider nicht.", "зайт цвай вохэн. ди зальбэ хильфт миа ляйдэа нихьт", "Уже две недели. Мазь мне, к сожалению, не помогает.", 1, "Seit zwei Wochen. Die Salbe hilft mir leider nicht."], ["wf5", "Ich untersuche Sie jetzt. Danach erkläre ich Ihnen alles.", "ихь унтэрзухэ зи йецт. данах эрклэрэ ихь инэн аллес", "Сейчас я Вас осмотрю. Потом всё Вам объясню.", 1, "Ich untersuche Sie jetzt. Danach erkläre ich Ihnen alles."], ["wf6", "Danke, das ist sehr nett von Ihnen.", "данкэ, дас ист зэа нэт фон инэн", "Спасибо, это очень любезно с Вашей стороны.", 1, "Danke, das ist sehr nett von Ihnen."], ["sh1", "Wie gefällt Ihnen der Strumpf?", "ви гэфэльт инэн дэа штрумпф", "Как Вам чулок?", 1, "Wie gefällt Ihnen der Strumpf?"], ["sh2", "Die Farbe gefällt mir, aber er passt mir nicht. Er ist zu kurz.", "ди фарбэ гэфэльт миа, абэа эа пасст миа нихьт. эа ист цу курц", "Цвет мне нравится, но он мне не подходит. Он слишком короткий.", 1, "Die Farbe gefällt mir, aber er passt mir nicht. Er ist zu kurz."], ["sh3", "Kein Problem, ich gebe Ihnen eine andere Größe.", "кайн проблэм, ихь гэбэ инэн айнэ андэрэ грёсэ", "Не проблема, я дам Вам другой размер.", 1, "Kein Problem, ich gebe Ihnen eine andere Größe."], ["sh4", "Können Sie mir zeigen, wie man ihn anzieht?", "кённэн зи миа цайгэн, ви ман ин анцийт", "Можете показать мне, как его надевать?", 1, "Können Sie mir zeigen, wie man ihn anzieht?"], ["sh5", "Gern, ich zeige es Ihnen.", "гэрн, ихь цайгэ эс инэн", "Конечно, я Вам покажу.", 1, "Gern, ich zeige es Ihnen."], ["sh6", "Vielen Dank, Sie helfen mir sehr.", "филен данк, зи хэльфэн миа зэа", "Большое спасибо, Вы мне очень помогаете.", 1, "Vielen Dank, Sie helfen mir sehr."], ["hf1", "Kannst du mir kurz helfen?", "канст ду миа курц хэльфэн", "Можешь мне на минутку помочь?", 1, "Kannst du mir kurz helfen?"], ["hf2", "Klar. Was brauchst du?", "клар. вас браухст ду", "Конечно. Что тебе нужно?", 1, "Klar. Was brauchst du?"], ["hf3", "Gib mir bitte den Schlüssel. Er gehört mir, nicht dir!", "гип миа биттэ дэн шлюссэль. эа гэхёрт миа, нихьт диа", "Дай мне, пожалуйста, ключ. Он мой, а не твой!", 1, "Gib mir bitte den Schlüssel. Er gehört mir, nicht dir!"], ["hf4", "Oh, Entschuldigung! Hier, ich gebe ihn dir.", "о, энтшульдигунг! хиа, ихь гэбэ ин диа", "Ой, извини! Вот, держи. (даю его тебе)", 1, "Oh, Entschuldigung! Hier, ich gebe ihn dir."], ["hf5", "Danke dir! Ich rufe dich heute Abend an.", "данкэ диа! ихь руфэ дихь хойтэ абэнт ан", "Спасибо! Я позвоню тебе вечером.", 1, "Danke dir! Ich rufe dich heute Abend an."], ["hf6", "Gut, bis später!", "гут, бис шпэтэа", "Хорошо, до скорого!", 1, "Gut, bis später!"]]