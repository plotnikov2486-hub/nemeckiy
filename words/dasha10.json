[["sb1", "der Steckbrief", "дэа штэкбриф", "анкета, короткое описание человека", 0, "der Steckbrief"], ["sb2", "der Familienname", "дэа фамилиэннамэ", "фамилия", 0, "der Familienname"], ["sb3", "der Wohnort", "дэа воонорт", "место жительства", 0, "der Wohnort"], ["sb4", "das Alter", "дас альта", "возраст", 0, "das Alter"], ["sb5", "der Familienstand", "дэа фамилиэнштант", "семейное положение", 0, "der Familienstand"], ["sb6", "geschieden", "гэшидэн", "разведён, разведена", 0, "geschieden"], ["sb7", "verheiratet", "фэрхайратэт", "женат, замужем", 0, "verheiratet"], ["sb8", "ledig", "лэдихь", "холост, не замужем", 0, "ledig"], ["gn1", "Ich heiße Gerda Nickels. Ich bin 36 und arbeite als Sekretärin.", "ихь хайсэ гэрда никэльс. ихь бин зэксунтдрайсихь унт арбайтэ альс зэкрэтэрин", "Меня зовут Герда Никкельс. Мне 36, я работаю секретарём.", 1, "Ich heiße Gerda Nickels. Ich bin 36 und arbeite <b>als</b> Sekretärin."], ["gn2", "Ich bin verheiratet. Mein Mann ist 43 und arbeitet bei Siemens.", "ихь бин фэрхайратэт. майн ман ист драйунтфирцихь унт арбайтэт бай зимэнс", "Я замужем. Моему мужу 43, он работает в Siemens.", 1, "Ich bin verheiratet. Mein Mann ist 43 und arbeitet <b>bei</b> Siemens."], ["gn3", "Wir arbeiten in München, aber wir wohnen hier in Gilching.", "вир арбайтэн ин мюнхьэн, аба вир воонэн хир ин гильхинг", "Мы работаем в Мюнхене, но живём здесь, в Гильхинге.", 1, "Wir arbeiten in München, <b>aber</b> wir wohnen hier in Gilching."], ["gd1", "Die zweite Frau heißt Gerda.", "ди цвайтэ фрау хайст гэрда", "Вторую женщину зовут Герда.", 1, "Die zweite Frau <b>heißt</b> Gerda."], ["gd2", "Gerdas Familienname ist Nickels.", "гэрдас фамилиэннамэ ист никэльс", "Фамилия Герды — Никкельс.", 1, "<b>Gerdas</b> Familienname <b>ist</b> Nickels."], ["gd3", "Sie wohnt in Gilching.", "зи воонт ин гильхинг", "Она живёт в Гильхинге. (глагол есть — sein не нужен)", 1, "Sie <b>wohnt</b> in Gilching."], ["gd4", "Sie ist Sekretärin von Beruf.", "зи ист зэкрэтэрин фон бэруф", "Она по профессии секретарь.", 1, "Sie <b>ist</b> Sekretärin von Beruf."], ["gd5", "Sie arbeitet in München.", "зи арбайтэт ин мюнхьэн", "Она работает в Мюнхене.", 1, "Sie <b>arbeitet</b> in München."], ["gd6", "Sie ist 36 Jahre alt.", "зи ист зэксунтдрайсихь ярэ альт", "Ей 36 лет.", 1, "Sie <b>ist</b> 36 Jahre alt."], ["gd7", "Sie ist verheiratet.", "зи ист фэрхайратэт", "Она замужем.", 1, "Sie <b>ist</b> verheiratet."], ["ps1", "Sie ist 36 Jahre alt.", "зи ист зэксунтдрайсихь ярэ альт", "Ей 36 лет. — по-русски глагола нет", 1, "Sie <b>ist</b> 36 Jahre alt."], ["ps2", "Sie ist verheiratet.", "зи ист фэрхайратэт", "Она замужем.", 1, "Sie <b>ist</b> verheiratet."], ["ps3", "Es ist zu spät.", "эс ист цу шпэт", "Уже (слишком) поздно.", 1, "Es <b>ist</b> zu spät."], ["ps4", "Er ist nicht zu Hause.", "эа ист нихьт цу хаузэ", "Его нет дома.", 1, "Er <b>ist</b> nicht zu Hause."], ["ps5", "Es ist kalt.", "эс ист кальт", "Холодно.", 1, "Es <b>ist</b> kalt."], ["ps6", "Ich bin müde.", "ихь бин мюдэ", "Я устал.", 1, "Ich <b>bin</b> müde."], ["ps7", "Sie wohnt in Gilching.", "зи воонт ин гильхинг", "Она живёт в Гильхинге. — глагол уже есть, sein не нужен", 1, "Sie <b>wohnt</b> in Gilching."], ["ps8", "Wo hast du Schmerzen?", "во хаст ду шмэрцэн", "Где у тебя болит? — боль «имеют»: haben", 1, "Wo <b>hast</b> du Schmerzen?"], ["gs1", "Opas Brille ist auf dem Tisch.", "опас брилэ ист ауф дэм тиш", "Дедушкины очки на столе.", 1, "<b>Opas</b> Brille ist auf dem Tisch."], ["gs2", "Peters Vater ist Ingenieur von Beruf.", "пэтэрс фата ист инжэниёр фон бэруф", "Отец Петера — инженер по профессии.", 1, "<b>Peters</b> Vater ist Ingenieur von Beruf."], ["gs3", "Gerdas Familienname ist Nickels.", "гэрдас фамилиэннамэ ист никэльс", "Фамилия Герды — Никкельс.", 1, "<b>Gerdas</b> Familienname ist Nickels."], ["gs4", "Omas Garten", "омас гартэн", "бабушкин сад", 1, "<b>Omas</b> Garten"], ["gs5", "Marias Mutter", "мариас мутта", "мама Марии", 1, "<b>Marias</b> Mutter"], ["se1", "Peters Vater ist Ingenieur von Beruf.", "пэтэрс фата ист инжэниёр фон бэруф", "Отец Петера — инженер по профессии.", 1, "Peters Vater <b>ist</b> Ingenieur von Beruf."], ["se2", "Irene und Jonas sind seit 2 Jahren verheiratet.", "ирэнэ унт йонас зинт зайт цвай ярэн фэрхайратэт", "Ирене и Йонас женаты уже два года.", 1, "Irene und Jonas <b>sind</b> seit 2 Jahren verheiratet."], ["se3", "Udo, wo bist du denn?", "удо, во бист ду дэн", "Удо, ты где?", 1, "Udo, wo <b>bist</b> du denn?"], ["se4", "Seid ihr aus Deutschland?", "зайт ир аус дойчлант", "Вы из Германии?", 1, "<b>Seid</b> ihr aus Deutschland?"], ["se5", "Ich bin fleißig, ich lerne gut.", "ихь бин фляйсихь, ихь лернэ гут", "Я прилежный, я хорошо учусь.", 1, "Ich <b>bin</b> fleißig, ich lerne gut."], ["se6", "Opas Brille ist auf dem Tisch.", "опас брилэ ист ауф дэм тиш", "Дедушкины очки на столе.", 1, "Opas Brille <b>ist</b> auf dem Tisch."], ["se7", "Wir sind schon sehr hungrig.", "вир зинт шон зэа хунгрихь", "Мы уже очень голодные.", 1, "Wir <b>sind</b> schon sehr hungrig."], ["se8", "Es ist zu spät, wir müssen schon gehen.", "эс ист цу шпэт, вир мюсэн шон гээн", "Уже поздно, нам пора идти.", 1, "Es <b>ist</b> zu spät, wir müssen schon gehen."], ["ha1", "Wir haben eine neue Wohnung.", "вир хабэн айнэ нойэ воонунг", "У нас новая квартира.", 1, "Wir <b>haben</b> eine neue Wohnung."], ["ha2", "Hast du Geschwister?", "хаст ду гэшвиста", "У тебя есть братья или сёстры?", 1, "<b>Hast</b> du Geschwister?"], ["ha3", "Ihr habt jeden Tag Deutschstunde.", "ир хапт йэдэн так дойчштундэ", "У вас каждый день урок немецкого.", 1, "Ihr <b>habt</b> jeden Tag Deutschstunde."], ["ha4", "Wer hat eine Idee?", "вэа хат айнэ идэ", "У кого есть идея? (wer — кто → hat)", 1, "Wer <b>hat</b> eine Idee?"], ["ha5", "Ich habe schon Bärenhunger.", "ихь хабэ шон бэрэнхунга", "Я уже голоден как волк.", 1, "Ich <b>habe</b> schon Bärenhunger."], ["ha6", "Peter und Karla haben zwei Kinder.", "пэта унт карла хабэн цвай кинда", "У Петера и Карлы двое детей.", 1, "Peter und Karla <b>haben</b> zwei Kinder."], ["ha7", "Die Eltern haben keine Zeit für das Kind.", "ди эльтэрн хабэн кайнэ цайт фюа дас кинт", "У родителей нет времени на ребёнка.", 1, "Die Eltern <b>haben</b> keine Zeit für das Kind."], ["ha8", "Ich habe für heute zwei Kinokarten.", "ихь хабэ фюа хойтэ цвай кинокартэн", "У меня на сегодня два билета в кино.", 1, "Ich <b>habe</b> für heute zwei Kinokarten."], ["wr1", "Eva ist krank. Sie hat Grippe.", "эва ист кранк. зи хат грипэ", "Ева больна. У неё грипп. (c)", 1, "Eva <b>ist</b> krank. Sie <b>hat</b> Grippe."], ["wr2", "Ich bin fleißig, ich habe gute Noten.", "ихь бин фляйсихь, ихь хабэ гутэ нотэн", "Я прилежный, у меня хорошие оценки. (a)", 1, "Ich <b>bin</b> fleißig, ich <b>habe</b> gute Noten."], ["wr3", "Wir haben einen Hund, er ist noch klein.", "вир хабэн айнэн хунт, эа ист нох кляйн", "У нас есть собака, она ещё маленькая. (a)", 1, "Wir <b>haben</b> einen Hund, er <b>ist</b> noch klein."], ["wr4", "Wo sind die Kinder? Sie sind bei der Oma.", "во зинт ди кинда? зи зинт бай дэа ома", "Где дети? Они у бабушки. (b)", 1, "Wo <b>sind</b> die Kinder? Sie <b>sind</b> bei der Oma."], ["wr5", "Seid ihr nicht müde? Doch, wir sind müde.", "зайт ир нихьт мюдэ? дох, вир зинт мюдэ", "Вы не устали? Да нет, устали. (c)", 1, "<b>Seid</b> ihr nicht müde? Doch, wir <b>sind</b> müde."], ["wr6", "Hans hat Judo, er ist nicht zu Hause.", "ханс хат юдо, эа ист нихьт цу хаузэ", "У Ханса дзюдо, его нет дома. (a)", 1, "Hans <b>hat</b> Judo, er <b>ist</b> nicht zu Hause."], ["wr7", "Es ist kalt. Am Himmel sind viele Wolken.", "эс ист кальт. ам химэль зинт филе волькэн", "Холодно. На небе много облаков. (c)", 1, "Es <b>ist</b> kalt. Am Himmel <b>sind</b> viele Wolken."], ["wr8", "Wir haben Pech, unser Auto ist kaputt.", "вир хабэн пэхь, унза ауто ист капут", "Нам не везёт, наша машина сломалась. (b)", 1, "Wir <b>haben</b> Pech, unser Auto <b>ist</b> kaputt."], ["wr9", "Das ist mein Zimmer. Es ist klein, aber hell.", "дас ист майн цима. эс ист кляйн, аба хэль", "Это моя комната. Она маленькая, но светлая. (a)", 1, "Das <b>ist</b> mein Zimmer. Es <b>ist</b> klein, aber hell."], ["wr10", "Wo hast du Schmerzen? Bist du wieder krank?", "во хаст ду шмэрцэн? бист ду вида кранк", "Где у тебя болит? Ты опять болеешь? (c)", 1, "Wo <b>hast</b> du Schmerzen? <b>Bist</b> du wieder krank?"], ["ho1", "Paul hat Schnupfen, er ist erkältet.", "пауль хат шнупфэн, эа ист эркэльтэт", "У Пауля насморк, он простужен.", 1, "Paul <b>hat</b> Schnupfen, er <b>ist</b> erkältet."], ["ho2", "Wir haben ein neues Auto, es ist sehr bequem.", "вир хабэн айн нойэс ауто, эс ист зэа бэквэм", "У нас новая машина, она очень удобная.", 1, "Wir <b>haben</b> ein neues Auto, es <b>ist</b> sehr bequem."], ["ho3", "Ich habe zwei Papageien zu Hause, sie sind sehr laut.", "ихь хабэ цвай папагайэн цу хаузэ, зи зинт зэа лаут", "У меня дома два попугая, они очень громкие.", 1, "Ich <b>habe</b> zwei Papageien zu Hause, sie <b>sind</b> sehr laut."], ["ho4", "Wir sind schon fünf Jahre in Wien, mein Vater hat dort eine gute Arbeit.", "вир зинт шон фюнф ярэ ин вин, майн фата хат дорт айнэ гутэ арбайт", "Мы уже пять лет в Вене, у папы там хорошая работа.", 1, "Wir <b>sind</b> schon fünf Jahre in Wien, mein Vater <b>hat</b> dort eine gute Arbeit."], ["ho5", "Ihr seid glücklich, ihr habt viel Geld.", "ир зайт глюклихь, ир хапт филь гэльт", "Вы счастливы, у вас много денег.", 1, "Ihr <b>seid</b> glücklich, ihr <b>habt</b> viel Geld."], ["ho6", "Du hast sehr viel zu tun, du bist immer müde.", "ду хаст зэа филь цу тун, ду бист има мюдэ", "У тебя очень много дел, ты всегда усталый.", 1, "Du <b>hast</b> sehr viel zu tun, du <b>bist</b> immer müde."], ["ho7", "Das Wetter ist schlecht, das ist mir egal, ich habe einen Regenschirm bei mir.", "дас вэта ист шлехьт, дас ист мир эгаль, ихь хабэ айнэн рэгэнширм бай мир", "Погода плохая, мне всё равно — у меня с собой зонт.", 1, "Das Wetter <b>ist</b> schlecht, das <b>ist</b> mir egal, ich <b>habe</b> einen Regenschirm bei mir."], ["ho8", "Haben Sie Lust, zu uns zu kommen?", "хабэн зи луст, цу унс цу комэн", "Хотите прийти к нам?", 1, "<b>Haben</b> Sie Lust, zu uns zu kommen?"], ["ho9", "Unsere Hobbys sind Reiten und Reisen.", "унзэрэ хобис зинт райтэн унт райзэн", "Наши хобби — верховая езда и путешествия.", 1, "Unsere Hobbys <b>sind</b> Reiten und Reisen."], ["nw1", "krank", "кранк", "больной", 0, "krank"], ["nw2", "die Grippe", "ди грипэ", "грипп", 0, "die Grippe"], ["nw3", "der Schnupfen", "дэа шнупфэн", "насморк", 0, "der Schnupfen"], ["nw4", "erkältet", "эркэльтэт", "простуженный", 0, "erkältet"], ["nw5", "die Schmerzen", "ди шмэрцэн", "боли, боль", 0, "die Schmerzen"], ["nw6", "müde", "мюдэ", "усталый", 0, "müde"], ["nw7", "fleißig", "фляйсихь", "прилежный, трудолюбивый", 0, "fleißig"], ["nw8", "die Note, die Noten", "ди нотэ, ди нотэн", "оценка, оценки (в школе)", 0, "die Note, die Noten"], ["nw9", "die Wohnung", "ди воонунг", "квартира", 0, "die Wohnung"], ["nw10", "die Geschwister", "ди гэшвиста", "братья и сёстры", 0, "die Geschwister"], ["nw11", "die Idee", "ди идэ", "идея", 0, "die Idee"], ["nw12", "der Hunger", "дэа хунга", "голод", 0, "der Hunger"], ["nw13", "der Bärenhunger", "дэа бэрэнхунга", "«медвежий голод», зверский голод", 0, "der Bärenhunger"], ["nw14", "hungrig", "хунгрихь", "голодный", 0, "hungrig"], ["nw15", "die Zeit", "ди цайт", "время", 0, "die Zeit"], ["nw16", "die Kinokarte", "ди кинокартэ", "билет в кино", 0, "die Kinokarte"], ["nw17", "der Himmel", "дэа химэль", "небо", 0, "der Himmel"], ["nw18", "die Wolke, die Wolken", "ди волькэ, ди волькэн", "облако, облака", 0, "die Wolke, die Wolken"], ["nw19", "das Pech", "дас пэхь", "невезение", 0, "das Pech"], ["nw20", "kaputt", "капут", "сломанный", 0, "kaputt"], ["nw21", "das Zimmer", "дас цима", "комната", 0, "das Zimmer"], ["nw22", "hell", "хэль", "светлый", 0, "hell"], ["nw23", "bequem", "бэквэм", "удобный", 0, "bequem"], ["nw24", "der Papagei, die Papageien", "дэа папагай, ди папагайэн", "попугай, попугаи",