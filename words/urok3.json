[["v_kommen", "kommen", "коммэн", "приходить; быть родом (aus …)", 1, "kommen"], ["v_wohnen", "wohnen", "вонэн", "жить (где-то)", 1, "wohnen"], ["v_heissen", "heißen", "хайсэн", "зваться", 1, "heißen"], ["v_arbeiten", "arbeiten", "арбайтэн", "работать", 1, "arbeiten"], ["v_lernen", "lernen", "лернэн", "учить, учиться", 1, "lernen"], ["v_machen", "machen", "махэн", "делать", 1, "machen"], ["v_spielen", "spielen", "шпилен", "играть", 1, "spielen"], ["v_brauchen", "brauchen", "браухэн", "нуждаться; нужно", 1, "brauchen"], ["v_verstehen", "verstehen", "фэрштээн", "понимать", 1, "verstehen"], ["v_sprechen", "sprechen", "шпрэхен", "говорить — du sprichst!", 1, "sprechen"], ["vm1", "untersuchen", "унтэрзухэн", "обследовать", 1, "untersuchen"], ["vm2", "behandeln", "бэхандэльн", "лечить — ich behandle", 1, "behandeln"], ["vm3", "operieren", "опэрирэн", "оперировать", 1, "operieren"], ["vm4", "fragen", "фрагэн", "спрашивать", 1, "fragen"], ["vm5", "antworten", "антвортэн", "отвечать — du antwortest", 1, "antworten"], ["vm6", "warten", "вартэн", "ждать — du wartest", 1, "warten"], ["vm7", "kontrollieren", "контроллирэн", "проверять, контролировать", 1, "kontrollieren"], ["vm8", "rauchen", "раухэн", "курить", 1, "rauchen"], ["vs1", "Ich untersuche Frau Weber.", "ихь унтэрзухэ фрау вэбэа", "Я обследую фрау Вебер.", 1, "Ich untersuche Frau Weber."], ["vs2", "Der Chirurg operiert heute.", "дэа хирург опэрирт хойтэ", "Хирург сегодня оперирует.", 1, "Der Chirurg operiert heute."], ["vs3", "Die Ärztin behandelt Kinder.", "ди эрцтин бэхандэльт киндэа", "Врач лечит детей.", 1, "Die Ärztin behandelt Kinder."], ["vs4", "Ich frage, Sie antworten.", "ихь фрагэ, зи антвортэн", "Я спрашиваю, Вы отвечаете.", 1, "Ich frage, Sie antworten."], ["vs5", "Bitte warten Sie hier.", "битэ вартэн зи хиа", "Пожалуйста, подождите здесь.", 1, "Bitte warten Sie hier."], ["lv1", "du arbeitest, er arbeitet", "ду арбайтэст, эа арбайтэт", "ты работаешь, он работает — вставная -e-", 1, "du arbeitest, er arbeitet"], ["lv2", "du findest, er findet", "ду финдэст, эа финдэт", "ты находишь, он находит — основа на -d", 1, "du findest, er findet"], ["lv3", "du heißt", "ду хайст", "тебя зовут — у du только -t", 1, "du heißt"], ["lv4", "du tanzt", "ду танцт", "ты танцуешь — основа на -z", 1, "du tanzt"], ["lv5", "ich behandle", "ихь бэхандлэ", "я лечу — у ich e выпадает", 1, "ich behandle"], ["s1", "Ich wohne in Moskau.", "ихь вонэ ин москау", "Я живу в Москве.", 1, "Ich wohne in Moskau."], ["s2", "In Moskau wohne ich.", "ин москау вонэ ихь", "В Москве живу я. — глагол всё равно второй", 1, "In Moskau wohne ich."], ["s3", "Ich arbeite als Arzt.", "ихь арбайтэ альс арцт", "Я работаю врачом.", 1, "Ich arbeite als Arzt."], ["s4", "Ich lerne Deutsch.", "ихь лернэ дойч", "Я учу немецкий.", 1, "Ich lerne Deutsch."], ["s5", "Ich spreche Russisch und ein bisschen Deutsch.", "ихь шпрэхе русиш унт айн бисхен дойч", "Я говорю по-русски и немного по-немецки.", 1, "Ich spreche Russisch und ein bisschen Deutsch."], ["iv1", "Heute arbeite ich in der Klinik.", "хойтэ арбайтэ ихь ин дэа клиник", "Сегодня я работаю в клинике.", 1, "Heute arbeite ich in der Klinik."], ["iv2", "Morgen lerne ich Deutsch.", "морген лернэ ихь дойч", "Завтра я учу немецкий.", 1, "Morgen lerne ich Deutsch."], ["iv3", "Jetzt kommt der Arzt.", "етцт коммт дэа арцт", "Сейчас придёт врач.", 1, "Jetzt kommt der Arzt."], ["iv4", "In Berlin wohnt meine Schwester.", "ин бэрлин вонт майнэ швэстэа", "В Берлине живёт моя сестра.", 1, "In Berlin wohnt meine Schwester."], ["q1", "Wo wohnen Sie?", "во вонэн зи", "Где Вы живёте?", 1, "Wo wohnen Sie?"], ["q4", "Was machen Sie beruflich?", "вас махэн зи бэруфлихь", "Кем Вы работаете?", 1, "Was machen Sie beruflich?"], ["wf1", "Was brauchen Sie?", "вас браухэн зи", "Что Вам нужно?", 1, "Was brauchen Sie?"], ["wf2", "Wie heißt du?", "ви хайст ду", "Как тебя зовут?", 1, "Wie heißt du?"], ["q2", "Wohnen Sie in Berlin?", "вонэн зи ин бэрлин", "Вы живёте в Берлине?", 1, "Wohnen Sie in Berlin?"], ["q3", "Sprechen Sie Deutsch?", "шпрэхен зи дойч", "Вы говорите по-немецки?", 1, "Sprechen Sie Deutsch?"], ["wf3", "Arbeiten Sie hier?", "арбайтэн зи хиа", "Вы здесь работаете?", 1, "Arbeiten Sie hier?"], ["wf4", "Verstehen Sie mich?", "фэрштээн зи михь", "Вы меня понимаете?", 1, "Verstehen Sie mich?"], ["wf5", "Rauchen Sie?", "раухэн зи", "Вы курите?", 1, "Rauchen Sie?"], ["ja1", "Ja, ich wohne in Berlin.", "я, ихь вонэ ин бэрлин", "Да, я живу в Берлине.", 1, "Ja, ich wohne in Berlin."], ["ja2", "Nein, ich wohne nicht in Berlin.", "найн, ихь вонэ нихьт ин бэрлин", "Нет, я живу не в Берлине.", 1, "Nein, ich wohne nicht in Berlin."], ["ja3", "Nein, ich wohne in Hamburg.", "найн, ихь вонэ ин хамбург", "Нет, я живу в Гамбурге.", 1, "Nein, ich wohne in Hamburg."], ["ja4", "Wohnen Sie nicht in Berlin?", "вонэн зи нихьт ин бэрлин", "Вы разве живёте не в Берлине?", 1, "Wohnen Sie nicht in Berlin?"], ["ja5", "Doch, ich wohne in Berlin.", "дох, ихь вонэ ин бэрлин", "Нет-нет, как раз в Берлине.", 1, "Doch, ich wohne in Berlin."], ["sz1", "Wohnen Sie hier?", "вонэн зи хиа", "Вы здесь живёте? — или «они здесь живут?»: по смыслу", 1, "Wohnen Sie hier?"], ["sz2", "Sie wohnt in Wien.", "зи вонт ин вин", "Она живёт в Вене. — окончание -t выдаёт «она»", 1, "Sie wohnt in Wien."], ["d1", "Guten Tag! Sind Sie auch Arzt?", "гутэн так! зинт зи аух арцт", "Здравствуйте! Вы тоже врач?", 1, "Guten Tag! Sind Sie auch Arzt?"], ["dm2", "Ja, ich bin Arzt. Und Sie?", "я, ихь бин арцт. унт зи", "Да, я врач. А Вы?", 1, "Ja, ich bin Arzt. Und Sie?"], ["d3", "Ich bin Ärztin. Ich arbeite in Berlin. Woher kommen Sie?", "ихь бин эрцтин. ихь арбайтэ ин бэрлин. вохэа коммэн зи", "Я врач. Работаю в Берлине. Откуда Вы?", 1, "Ich bin Ärztin. Ich arbeite in Berlin. Woher kommen Sie?"], ["dm4", "Ich komme aus Russland. Ich lerne Deutsch.", "ихь коммэ аус русланд. ихь лернэ дойч", "Я из России. Учу немецкий.", 1, "Ich komme aus Russland. Ich lerne Deutsch."], ["d5", "Sprechen Sie schon gut Deutsch?", "шпрэхен зи шон гут дойч", "Вы уже хорошо говорите по-немецки?", 1, "Sprechen Sie schon gut Deutsch?"], ["dm6", "Ein bisschen. Ich lerne jeden Tag.", "айн бисхен. ихь лернэ едэн так", "Немного. Учу каждый день.", 1, "Ein bisschen. Ich lerne jeden Tag."], ["d7", "Toll! Weiter so!", "толь! вайтэа зо", "Здорово! Так держать!", 1, "Toll! Weiter so!"], ["kl1", "Hallo Grigori! Wo wohnst du jetzt?", "халло григори! во вонст ду етцт", "Привет, Григорий! Где ты сейчас живёшь?", 1, "Hallo Grigori! Wo wohnst du jetzt?"], ["kl2", "Ich wohne in Neukölln. Und du?", "ихь вонэ ин нойкёльн. унт ду", "Я живу в Нойкёльне. А ты?", 1, "Ich wohne in Neukölln. Und du?"], ["kl3", "Ich wohne in Pankow. Was machst du heute Abend?", "ихь вонэ ин панко. вас махст ду хойтэ абэнт", "Я — в Панкове. Что делаешь сегодня вечером?", 1, "Ich wohne in Pankow. Was machst du heute Abend?"], ["kl4", "Heute Abend lerne ich Deutsch.", "хойтэ абэнт лернэ ихь дойч", "Сегодня вечером учу немецкий.", 1, "Heute Abend lerne ich Deutsch."], ["kl5", "Du lernst jeden Tag, oder?", "ду лернст едэн так, одэа", "Ты учишь каждый день, да?", 1, "Du lernst jeden Tag, oder?"], ["kl6", "Ja. Ich brauche Deutsch für die Arbeit.", "я. ихь браухэ дойч фюа ди арбайт", "Да. Мне нужен немецкий для работы.", 1, "Ja. Ich brauche Deutsch für die Arbeit."], ["kl7", "Du sprichst schon gut!", "ду шприхст шон гут", "Ты уже хорошо говоришь!", 1, "Du sprichst schon gut!"], ["kl8", "Danke! Ich verstehe schon viel.", "данкэ! ихь фэрштээ шон филь", "Спасибо! Я уже много понимаю.", 1, "Danke! Ich verstehe schon viel."], ["pa1", "Guten Tag! Wie heißen Sie?", "гутэн так! ви хайсэн зи", "Здравствуйте! Как Вас зовут?", 1, "Guten Tag! Wie heißen Sie?"], ["pa2", "Ich heiße Lisa Braun.", "ихь хайсэ лиза браун", "Меня зовут Лиза Браун.", 1, "Ich heiße Lisa Braun."], ["pa3", "Was machen Sie beruflich, Frau Braun?", "вас махэн зи бэруфлихь, фрау браун", "Кем Вы работаете, фрау Браун?", 1, "Was machen Sie beruflich, Frau Braun?"], ["pa4", "Ich arbeite als Lehrerin.", "ихь арбайтэ альс лерэрин", "Я работаю учительницей.", 1, "Ich arbeite als Lehrerin."], ["pa5", "Rauchen Sie?", "раухэн зи", "Вы курите?", 1, "Rauchen Sie?"], ["pa6", "Nein, ich rauche nicht.", "найн, ихь раухэ нихьт", "Нет, не курю.", 1, "Nein, ich rauche nicht."], ["pa7", "Brauchen Sie ein Rezept?", "браухэн зи айн рэцэпт", "Вам нужен рецепт?", 1, "Brauchen Sie ein Rezept?"], ["pa8", "Ja, bitte. Ich brauche Tabletten.", "я, битэ. ихь браухэ таблэттэн", "Да, пожалуйста. Мне нужны таблетки.", 1, "Ja, bitte. Ich brauche Tabletten."]]